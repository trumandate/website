---
// /ar/strategy — "الاستراتيجية ومؤشرات الأداء" (P6-AR). Same route, same
// five-part skeleton and the same shared components as /en/strategy: this file
// differs from its English sibling only in the `lang` constant, which selects
// the Arabic branch of `productCopy` and puts the fragment into its mirrored
// geometry. No parallel Arabic component tree (PLAN.md §1's "keep one shared
// component rather than creating a variant").
//
// The Arabic is written, not translated (BUILD_FLAGS): the page's argument —
// the objective tree is the easy part, the break happens at the KPI, the KPI
// becomes the join, the baseline is non-negotiable — is carried in four
// paragraphs of Arabic prose that are not sentence-for-sentence mirrors of the
// English. Plain-prose version in COPY-REVIEW.md for review.
//
// Curiosity ledger, identical to the English route: the cascade and how
// weighting works appear nowhere except the handoff sentence, which promises
// them. Grep-checked over the rendered Arabic — تدرّج / وزن / موزون / ترجيح
// occur only inside `handoff`.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductPage from "../../components/product/ProductPage.astro";
import KpiCard from "../../components/fragments/KpiCard.astro";
import { productCopy } from "../../components/product/copy";

const lang = "ar" as const;
const copy = productCopy[lang].strategy;
---

<BaseLayout
  lang={lang}
  path="/strategy"
  title={copy.documentTitle}
  description={copy.documentDescription}
>
  <ProductPage lang={lang} copy={copy}>
    <KpiCard slot="fragment" lang={lang} />
  </ProductPage>
</BaseLayout>
