---
// /ar/strategy — "الاستراتيجية ومؤشرات الأداء". Same route, same skeleton
// and fragment as /en/strategy; only `lang` differs, selecting the Arabic
// branch of `productCopy` and the fragment's mirrored crop.
//
// The Arabic is carried verbatim from `Strategy AR (redesign).dc.html`
// (redesign wave B), not translated from the English sentence-for-sentence.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductPage from "../../components/product/ProductPage.astro";
import KpiCard from "../../components/fragments/KpiCard.astro";
import { productCopy } from "../../components/product/copy";

const lang = "ar" as const;
const copy = productCopy[lang].strategy;
---

<BaseLayout
  lang={lang}
  path="/strategy"
  title={copy.documentTitle}
  description={copy.documentDescription}
>
  <ProductPage lang={lang} copy={copy}>
    <KpiCard slot="fragment" lang={lang} caption={copy.fragmentCaption} />
  </ProductPage>
</BaseLayout>

<script src="../../scripts/redesignReveal.ts"></script>
