---
// src/pages/ar/index.astro — redesign wave A. Same composition as
// src/pages/en/index.astro (every component below takes `lang` and reads
// its own copy from i18n/ui.ts's bilingual tables) — see that file's own
// comment for the section order and what it replaces.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/home/Hero.astro";
import ProofBand from "../../components/home/ProofBand.astro";
import AiQueue from "../../components/home/AiQueue.astro";
import RecordChain from "../../components/chain/RecordChain.astro";
import WithoutRecord from "../../components/home/WithoutRecord.astro";
import ClosingCta from "../../components/home/ClosingCta.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "ar" as const;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  path="/"
  title={t("meta.home.title")}
  description={t("meta.home.description")}
>
  <Hero lang={lang} />
  <ProofBand lang={lang} />
  <AiQueue lang={lang} />
  <RecordChain lang={lang} />
  <WithoutRecord lang={lang} />
  <ClosingCta lang={lang} />
</BaseLayout>

<script src="../../scripts/redesignReveal.ts"></script>
