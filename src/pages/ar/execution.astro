---
// /ar/execution — "التنفيذ والحوكمة". Same route, same skeleton and
// fragment as /en/execution; only `lang` differs.
//
// The Arabic is carried verbatim from `Execution AR (redesign).dc.html`
// (redesign wave B).
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductPage from "../../components/product/ProductPage.astro";
import InitiativeRows from "../../components/fragments/InitiativeRows.astro";
import { productCopy } from "../../components/product/copy";

const lang = "ar" as const;
const copy = productCopy[lang].execution;
---

<BaseLayout
  lang={lang}
  path="/execution"
  title={copy.documentTitle}
  description={copy.documentDescription}
>
  <ProductPage lang={lang} copy={copy}>
    <InitiativeRows slot="fragment" lang={lang} caption={copy.fragmentCaption} />
  </ProductPage>
</BaseLayout>

<script src="../../scripts/redesignReveal.ts"></script>
