---
// /ar/benefits — "تحقيق المنافع" (P6-AR). Composes the same
// ProductPage.astro skeleton and the same BenefitCurve fragment as
// /en/benefits; only `lang` differs, which selects the Arabic copy branch and
// the fragment's mirrored geometry — including its time axis, which runs
// right-to-left here.
//
// The Arabic is written, not translated: the argument — benefits are forecast
// when optimism is rewarded and measured never; the same saving gets promised
// three times because tracking stops at closure; TruMandate keeps the benefit
// alive for 24 months past closure against the exact KPI it promised to move;
// this is the part that decides whether the rest is worth anything — is
// carried in four paragraphs of Arabic prose. Plain-prose version in
// COPY-REVIEW.md.
//
// Curiosity ledger, identical to the English route: "سجل المنافع" (the benefit
// register) occurs exactly once on this page, in the handoff sentence, and
// nothing anywhere explains how a benefit is apportioned to the work that
// produced it.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductPage from "../../components/product/ProductPage.astro";
import BenefitCurve from "../../components/fragments/BenefitCurve.astro";
import { productCopy } from "../../components/product/copy";

const lang = "ar" as const;
const copy = productCopy[lang].benefits;
---

<BaseLayout
  lang={lang}
  title={copy.documentTitle}
  description={copy.documentDescription}
>
  <ProductPage lang={lang} copy={copy}>
    <BenefitCurve slot="fragment" lang={lang} />
  </ProductPage>
</BaseLayout>
