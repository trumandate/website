---
// /ar/benefits — "تحقيق المنافع". Same route, same skeleton and fragment as
// /en/benefits; only `lang` differs.
//
// The Arabic is carried verbatim from `Benefits AR (redesign).dc.html`
// (redesign wave B).
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductPage from "../../components/product/ProductPage.astro";
import BenefitCurve from "../../components/fragments/BenefitCurve.astro";
import { productCopy } from "../../components/product/copy";

const lang = "ar" as const;
const copy = productCopy[lang].benefits;
---

<BaseLayout
  lang={lang}
  path="/benefits"
  title={copy.documentTitle}
  description={copy.documentDescription}
>
  <ProductPage lang={lang} copy={copy}>
    <BenefitCurve slot="fragment" lang={lang} caption={copy.fragmentCaption} />
  </ProductPage>
</BaseLayout>

<script src="../../scripts/redesignReveal.ts"></script>
