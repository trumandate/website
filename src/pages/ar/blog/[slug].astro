---
// /ar/blog/[slug] — the Arabic post route. Mirrors
// src/pages/en/blog/[slug].astro exactly; see that file for the route's own
// comment.
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogPostArticle from "../../../components/blog/BlogPostArticle.astro";
import BlogPostJsonLd from "../../../components/seo/BlogPostJsonLd.astro";
import { getPublishedPosts, parseFaq, type BlogPost } from "../../../lib/blog";

// See src/pages/en/blog/[slug].astro's own comment: `getStaticPaths` runs in
// an isolated build chunk that can't see a sibling top-level `const lang`,
// so the literal is repeated here rather than shared with the module-level
// `lang` below.
export async function getStaticPaths() {
  const posts = await getPublishedPosts("ar");
  return posts.map((post) => ({
    params: { slug: post.data.translationKey },
    props: { post },
  }));
}

const lang = "ar" as const;

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await render(post);

const posts = await getPublishedPosts(lang);
const index = posts.findIndex((p) => p.id === post.id);
const prevPost = index > 0 ? posts[index - 1] : null;
const nextPost = index >= 0 && index < posts.length - 1 ? posts[index + 1] : null;

const faq = parseFaq(post.body ?? "", lang);
---

<BaseLayout
  lang={lang}
  path={`/blog/${post.data.translationKey}`}
  title={`${post.data.title} — TruMandate`}
  description={post.data.description}
  rssHref={`/${lang}/blog/rss.xml`}
>
  <BlogPostJsonLd
    lang={lang}
    slug={post.data.translationKey}
    title={post.data.title}
    description={post.data.description}
    pubDate={post.data.pubDate}
    faq={faq}
  />
  <BlogPostArticle lang={lang} post={post} prevPost={prevPost} nextPost={nextPost}>
    <Content />
  </BlogPostArticle>
</BaseLayout>
