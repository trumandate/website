---
// /ar/contact — "تواصل" (P7). Same ContactPage.astro skeleton as
// /en/contact; content brief §7's Arabic is verbatim, the invented strings
// (honeypot, validation, submission status) are written directly in Arabic
// per BUILD_FLAGS rather than translated from the English sentences — see
// i18n/types.ts's `contact` doc comment and i18n/ui.ts's `ar.contact` block.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactPage from "../../components/contact/ContactPage.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "ar" as const;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  path="/contact"
  title={t("meta.contact.title")}
  description={t("meta.contact.description")}
>
  <ContactPage lang={lang} />
</BaseLayout>
