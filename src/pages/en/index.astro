---
// src/pages/en/index.astro — redesign wave A (docs/design_handoff_website_
// redesign/README.md — Home). Replaces the pre-redesign home entirely:
// board-led hero, proof band, AI decision queue, the signature 480vh
// record chain, "without the record", closing CTA. Section order per
// README §1: Hero → ProofBand → AiQueue → RecordChain → WithoutRecord →
// ClosingCta.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/home/Hero.astro";
import ProofBand from "../../components/home/ProofBand.astro";
import AiQueue from "../../components/home/AiQueue.astro";
import RecordChain from "../../components/chain/RecordChain.astro";
import WithoutRecord from "../../components/home/WithoutRecord.astro";
import ClosingCta from "../../components/home/ClosingCta.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "en" as const;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  path="/"
  title={t("meta.home.title")}
  description={t("meta.home.description")}
>
  <Hero lang={lang} />
  <ProofBand lang={lang} />
  <AiQueue lang={lang} />
  <RecordChain lang={lang} />
  <WithoutRecord lang={lang} />
  <ClosingCta lang={lang} />
</BaseLayout>

<script src="../../scripts/redesignReveal.ts"></script>
