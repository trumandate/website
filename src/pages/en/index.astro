---
// src/pages/en/index.astro — the real home page (P2). Replaces the P1
// scaffold-verification harness at src/pages/index.astro, which now just
// redirects here. English only for this build; the /ar route lands at P5
// (see TODO.md — page-body copy below is not yet in i18n/ui.ts's typed,
// bilingual dictionary, unlike the header/footer chrome, because there is
// no second language tree to keep in sync with yet).
//
// Section order per spec §6 / PLAN.md §3: hero, three failure modes, the
// traceability chain, one AI moment, the dimmed Command Centre CTA. No
// module list, no inline contact form, no sovereignty band, no second full
// Command Centre section — all four dropped by the P0-gate decisions in
// BUILD_FLAGS.md.
//
// Motion (P4, spec §7 items 2–6): every section carries a <Reveal> around
// its intro/text content (motion #2); the chain (motion #1) and the AI
// card's arrival + confidence fill (motion #4) run from their own scripts;
// the hero's "Benefit to date" counts up (motion #5) and its sparkline
// fades in (the "drawn on scroll" brief language downgraded to a fade, an
// ordinary <Reveal> instance, not a seventh animation); the chain's
// stage-gate fragment reveals via a masked wipe (motion #3). Every one of
// these is gated by motion.ts's whenMotionSafe, so the page's *served*
// state — what a reduced-motion reader or a JS-disabled reader sees — is
// still every section already in its final, correct, fully-legible state.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/layout/Section.astro";
import Hero from "../../components/home/Hero.astro";
import FailureModes from "../../components/home/FailureModes.astro";
import ChainSection from "../../components/chain/ChainSection.astro";
import ClosingCta from "../../components/home/ClosingCta.astro";
import Eyebrow from "../../components/type/Eyebrow.astro";
import Heading from "../../components/type/Heading.astro";
import SuggestionCard from "../../components/ai/SuggestionCard.astro";
import Reveal from "../../components/ui/Reveal.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "en" as const;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title="TruMandate — Every mandate, traced to the outcome it promised."
  description="TruMandate holds strategy, KPIs, initiatives and benefits in one record, so the office that sets direction can see what that direction produced."
>
  <Section>
    <Hero lang={lang} />
  </Section>

  <Section>
    <FailureModes lang={lang} />
  </Section>

  <ChainSection lang={lang} />

  <Section>
    <div class="grid grid-cols-1 gap-gutter lg:grid-cols-2">
      <div class="relative">
        <!-- The spine continues out of the chain, into this section, and
             stops at the suggestion card's inline-start edge (PLAN.md §3):
             a full-height rail (matching this grid row's stretched height,
             which follows the taller card column) plus a short tick
             gesturing across toward the card. -->
        <span
          aria-hidden="true"
          class="pointer-events-none absolute bottom-0 top-0 w-px start-node-inset bg-accent"
        ></span>
        <span
          aria-hidden="true"
          class="pointer-events-none absolute bottom-0 h-px w-6 start-node-inset bg-accent"
        ></span>

        <Reveal as="div" class="ps-rail">
          <Eyebrow>{t("home.ai.eyebrow")}</Eyebrow>
          <Heading as="h2" class="mt-4 max-w-measure">
            {t("home.ai.heading")}
          </Heading>
          <p class="mt-6 max-w-measure text-body font-light text-body">
            {t("home.ai.body")}
          </p>
        </Reveal>
      </div>

      <div>
        <SuggestionCard lang={lang} />
      </div>
    </div>
  </Section>

  <Section bleed>
    <ClosingCta lang={lang} />
  </Section>
</BaseLayout>
