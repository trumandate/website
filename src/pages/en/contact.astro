---
// /en/contact — "Request a walkthrough" (P7). Content brief §7, verbatim
// fields and lede copy; the honeypot, validation and submission-status
// copy are invented per BUILD_FLAGS' "written, not machine-translated" rule
// (see i18n/types.ts's `contact` doc comment for the full list).
//
// Structure is not this file's to choose — ContactPage.astro owns it, the
// same "one shared skeleton, lang prop only" pattern ProductPage.astro
// already established for /strategy, /execution and /benefits.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactPage from "../../components/contact/ContactPage.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "en" as const;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  path="/contact"
  title={t("meta.contact.title")}
  description={t("meta.contact.description")}
>
  <ContactPage lang={lang} />
</BaseLayout>
