---
// /en/execution — "Execution and governance". Redesign wave B (docs/design_
// handoff_website_redesign/README.md §3, Execution (redesign).dc.html — hue
// mint). Expands one link of the home page's traceability chain: Initiative
// → Milestone.
//
// Curiosity ledger for this route, unchanged from the pre-redesign version:
//   Reveals  — four stacked initiative rows, cropped by a bottom fade.
//   Withholds — the gate workflow and the approval routing.
// Named only in `handoff` — verified by grep, both languages.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductPage from "../../components/product/ProductPage.astro";
import InitiativeRows from "../../components/fragments/InitiativeRows.astro";
import { productCopy } from "../../components/product/copy";

const lang = "en" as const;
const copy = productCopy[lang].execution;
---

<BaseLayout
  lang={lang}
  path="/execution"
  title={copy.documentTitle}
  description={copy.documentDescription}
>
  <ProductPage lang={lang} copy={copy}>
    <InitiativeRows slot="fragment" lang={lang} caption={copy.fragmentCaption} />
  </ProductPage>
</BaseLayout>

<script src="../../scripts/redesignReveal.ts"></script>
