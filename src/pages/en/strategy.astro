---
// /en/strategy — "Strategy and KPIs". Redesign wave B (docs/design_handoff_
// website_redesign/README.md §2, Strategy (redesign).dc.html — hue cyan).
// Expands one link of the home page's traceability chain: Objective → KPI.
//
// Structure belongs to ProductPage.astro; copy to components/product/copy.ts
// (rewritten this wave — see that file's own header for why the shape
// changed). This file supplies the page key and the one fragment, exactly
// like its two siblings.
//
// Curiosity ledger for this route, unchanged from the pre-redesign version:
//   Reveals  — one full KPI record, plus a half-visible second card.
//   Withholds — the cascade editor and how weighting works.
// Named only in `handoff` — verified by grep, both languages.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductPage from "../../components/product/ProductPage.astro";
import KpiCard from "../../components/fragments/KpiCard.astro";
import { productCopy } from "../../components/product/copy";

const lang = "en" as const;
const copy = productCopy[lang].strategy;
---

<BaseLayout
  lang={lang}
  path="/strategy"
  title={copy.documentTitle}
  description={copy.documentDescription}
>
  <ProductPage lang={lang} copy={copy}>
    <KpiCard slot="fragment" lang={lang} caption={copy.fragmentCaption} />
  </ProductPage>
</BaseLayout>

<script src="../../scripts/redesignReveal.ts"></script>
