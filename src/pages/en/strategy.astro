---
// /en/strategy — "Strategy and KPIs" (P6). Expands one link of the home
// page's traceability chain: Objective → KPI. The one question it answers:
// how does a national mandate become a number someone owns?
//
// Structure is not this file's to choose — ProductPage.astro owns the shared
// five-part skeleton and all three product pages compose it identically
// (trumandate-product-pages.md: "Every product page uses this order. No page
// invents a new structure."). Copy is not this file's either any more: since
// the Arabic landed (P6-AR) both languages live side by side in
// `components/product/copy.ts`, so an English string cannot exist without an
// Arabic one. This file supplies exactly two things: which copy object, and
// which fragment.
//
// Curiosity ledger for this route:
//   Reveals  — one KPI card, fully readable (KpiCard.astro).
//   Withholds — the cascade editor and how weighting works.
// The withheld pair appears nowhere on this page except inside `handoff`,
// which is the sentence whose whole job is to promise it. Not in the
// argument, not in the fragment, not in the fragment's aria-label, not in the
// AI card. Same in Arabic on /ar/strategy — verified by grep, both languages.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductPage from "../../components/product/ProductPage.astro";
import KpiCard from "../../components/fragments/KpiCard.astro";
import { productCopy } from "../../components/product/copy";

const lang = "en" as const;
const copy = productCopy[lang].strategy;
---

<BaseLayout
  lang={lang}
  title={copy.documentTitle}
  description={copy.documentDescription}
>
  <ProductPage lang={lang} copy={copy}>
    <KpiCard slot="fragment" lang={lang} />
  </ProductPage>
</BaseLayout>
