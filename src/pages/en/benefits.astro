---
// /en/benefits — "Benefits realisation". Redesign wave B (docs/design_
// handoff_website_redesign/README.md §4, Benefits (redesign).dc.html — hue
// gold). Expands the last link of the home page's traceability chain:
// Benefit.
//
// Curiosity ledger for this route, unchanged from the pre-redesign version:
//   Reveals  — the forecast-vs-actual curve shape, cropped inline-end.
//   Withholds — the benefit register and the attribution logic.
// Named only in `handoff` — verified by grep, both languages.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductPage from "../../components/product/ProductPage.astro";
import BenefitCurve from "../../components/fragments/BenefitCurve.astro";
import { productCopy } from "../../components/product/copy";

const lang = "en" as const;
const copy = productCopy[lang].benefits;
---

<BaseLayout
  lang={lang}
  path="/benefits"
  title={copy.documentTitle}
  description={copy.documentDescription}
>
  <ProductPage lang={lang} copy={copy}>
    <BenefitCurve slot="fragment" lang={lang} caption={copy.fragmentCaption} />
  </ProductPage>
</BaseLayout>

<script src="../../scripts/redesignReveal.ts"></script>
