---
// /en/benefits — "Benefits realisation" (P6). Expands the last link of the
// home page's traceability chain: Benefit. The one question it answers: how do
// you know the outcome happened, after the team has gone?
//
// Structure belongs to ProductPage.astro and copy to
// components/product/copy.ts's bilingual table; this file supplies the page
// key and the one fragment, exactly like the other two product pages.
//
// Curiosity ledger for this route:
//   Reveals  — the forecast curve shape (BenefitCurve.astro).
//   Withholds — the benefit register and the attribution logic.
// Neither appears in the argument, the caption, the fragment, its aria-label
// or the AI card. The word "register" occurs exactly once on this page, in
// `handoff`, which is the sentence whose job is to promise it; nothing
// anywhere on the page explains how a benefit is apportioned to the work that
// produced it. The Arabic holds the same line: "سجل المنافع" occurs once, in
// the Arabic handoff, and nowhere else on /ar/benefits.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductPage from "../../components/product/ProductPage.astro";
import BenefitCurve from "../../components/fragments/BenefitCurve.astro";
import { productCopy } from "../../components/product/copy";

const lang = "en" as const;
const copy = productCopy[lang].benefits;
---

<BaseLayout
  lang={lang}
  path="/benefits"
  title={copy.documentTitle}
  description={copy.documentDescription}
>
  <ProductPage lang={lang} copy={copy}>
    <BenefitCurve slot="fragment" lang={lang} />
  </ProductPage>
</BaseLayout>
