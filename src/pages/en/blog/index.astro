---
// /en/blog — the blog index (BUILD_FLAGS.md's 2026-08-19 decisions-log
// entry: "blog section added for SEO and LLM discoverability"). Same
// composition idiom as the three product pages (BaseLayout + one content
// component + page-level SEO wiring) — see src/pages/en/strategy.astro.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogIndex from "../../../components/blog/BlogIndex.astro";
import BlogIndexJsonLd from "../../../components/seo/BlogIndexJsonLd.astro";
import { useTranslations } from "../../../i18n/utils";
import { getPublishedPosts } from "../../../lib/blog";

const lang = "en" as const;
const t = useTranslations(lang);
const posts = await getPublishedPosts(lang);
---

<BaseLayout
  lang={lang}
  path="/blog"
  title={t("blog.metaTitle")}
  description={t("blog.metaDescription")}
  rssHref={`/${lang}/blog/rss.xml`}
>
  <BlogIndexJsonLd
    slot="head"
    lang={lang}
    title={t("blog.metaTitle")}
    description={t("blog.metaDescription")}
  />
  <BlogIndex lang={lang} posts={posts} />
</BaseLayout>
