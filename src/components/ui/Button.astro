---
// Button.astro — the one shared button component, primary + ghost variants
// in a single file (PLAN.md §1; BUILD_FLAGS "keep one shared component
// rather than a variant"). Deferred from P1 to P2 (TODO.md); first used by
// Hero's two CTAs, and Header's inline-styled CTA is swapped to use it here
// so button styling lives in exactly one place.
//
// Primary hovers by inverting — bg-accent/text-ink becomes
// bg-transparent/text-accent with an accent outline — rather than a
// brightness nudge. Costs no new colour token (PLAN.md §2: "no accent hover
// token... reads as a deliberate state change rather than a brightness
// nudge"). Ghost is the same idea at rest: a hairline outline rather than a
// filled surface, so two CTAs never compete for attention.
//
// `whitespace-nowrap shrink-0` (P8 fix, known-issues.md P1/P2/P6/P6-AR/P7):
// the header's CTA wrapped to two lines because as a bare flex-item it
// defaulted to `flex-shrink: 1`, so any flex-layout rounding (a sub-pixel
// deficit at 1440, real crowding against the logo lockup and language toggle
// at 375) shrank the anchor a hair under its own text's single-line width and
// forced a word onto a second line. Every Button instance now refuses to
// shrink or wrap; in Hero's `flex flex-wrap` CTA row this means a whole
// button drops to the next line at narrow widths rather than its own label
// splitting mid-phrase.
interface Props {
  variant?: "primary" | "ghost";
  href?: string;
  type?: "button" | "submit";
  class?: string;
  /** Redesign wave A: the home hero's and closing CTA's four buttons carry
   * the reference's own explicit `min-height: 46px; padding-inline: 24px`
   * (Home (redesign).dc.html) — bigger than this component's default `px-4
   * py-2` (still correct for the header/contact/handoff call sites the
   * reference leaves at Tailwind's own padding). An inline style reliably
   * overrides the class-based padding (higher specificity than a same-
   * specificity utility class, which is not guaranteed to win by source
   * order under Tailwind's own internal rule ordering) without adding a
   * third variant for two call sites. */
  style?: string;
}

const {
  variant = "primary",
  href,
  type = "button",
  class: className,
  style,
}: Props = Astro.props;

// P10 (DESIGN-ELEVATION.md §3.8): the bare `transition` utility covers
// colour/border/outline/box-shadow/transform in one property list, paired
// with the micro tier (150ms, y-never-exceeds-1 easing) rather than the
// content-motion `state`/`standard` pair. `motion-safe:` gates the seat —
// under `prefers-reduced-motion: reduce` the transform never enters the
// cascade at all, so hover/press are colour-only there, which is correct
// (a colour state is information, not motion).
const base =
  "inline-flex shrink-0 items-center justify-center whitespace-nowrap rounded-control px-4 py-2 text-small font-semi transition duration-micro ease-micro motion-safe:hover:-translate-y-px motion-safe:active:translate-y-0";

const variants: Record<NonNullable<Props["variant"]>, string> = {
  primary:
    "bg-accent text-ink hover:bg-transparent hover:text-accent hover:outline hover:outline-hair hover:outline-accent",
  ghost:
    "bg-transparent text-paper outline outline-hair outline-hairline hover:text-accent hover:outline-accent",
};

const classes = [base, variants[variant], className].filter(Boolean).join(" ");
---

{
  href ? (
    <a href={href} class={classes} style={style}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} style={style}>
      <slot />
    </button>
  )
}
