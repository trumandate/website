---
// Rule.astro — the hairline, solid or dashed (spec §3: "sections separate
// with hairline rules, not cards"). A block-direction (horizontal) divider;
// unrelated to Spine.astro, which is the inline-start vertical rail.
//
// P10 (DESIGN-ELEVATION.md §3.4, §5.2): FailureModes.astro's three instances
// draw via a `scaleX(0 → 1)` tween (scripts/reveal.ts's group handler).
// `transform-origin` is pinned to the inline-start edge here so the draw
// reads correctly under RTL — Tailwind's own `origin-*` utilities are
// physical-only (`origin-left`/`origin-right`), so this uses the
// `:global([dir="rtl"])` scoped-style pattern SuggestionCard.astro already
// established at P5. Harmless on every other Rule instance that never
// animates: an unused transform-origin has no visible effect.
//
// `soft` (DESIGN-ELEVATION.md §4.3a): the product-page argument column's
// rule is decoration acknowledging a layout change, not a content-level
// boundary, so it uses `hairline-soft` (§2.1: "chrome/decoration only")
// rather than `hairline`. An optional prop rather than a second component —
// BUILD_FLAGS' "keep one shared component rather than creating a variant."
interface Props {
  dashed?: boolean;
  soft?: boolean;
  class?: string;
}

const { dashed = false, soft = false, class: className }: Props = Astro.props;
---

<hr
  class:list={[
    "m-0 border-0 border-t",
    soft ? "border-hairline-soft" : "border-hairline",
    dashed ? "border-dashed" : "border-solid",
    className,
  ]}
/>

<style>
  hr {
    transform-origin: 0% 50%;
  }

  :global([dir="rtl"]) hr {
    transform-origin: 100% 50%;
  }
</style>
