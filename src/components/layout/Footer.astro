---
// Footer.astro — bilingual-ready, English-only for now. Copy is verbatim
// from the content brief's Global section.
//
// Spec §5A asks for an Intertec Systems logo SVG here. Resolved at this
// pass: `IntertecLogo.astro`, re-authored from the reference file Piyush
// supplied at the end of P9 (`assets/intertec-logo.svg`, reference-only,
// never shipped — see that component's own comment for the full geometry
// writeup) as a monochrome `currentColor` mark, replaces the "Intertec
// Systems" half of the brand-credit line; the "Dubai" half stays as plain
// text (`footer.location`), joined by a presentational middot. The logo
// carries the full "Intertec Systems" company name as its own aria-label
// (`footer.company`, unchanged value, just no longer rendered as visible
// text) so a screen reader announces exactly what it announced before this
// swap. `text-muted` on the wrapping div is the only colour either the logo
// or the text needs — currentColor does the rest.
//
// The ISO 27001 mark spec §5A also lists is not here by a different,
// permanent reason: see SovereigntyBand.astro's own comment — Intertec
// Systems holds company-level certifications, the TruMandate product does
// not, and this build does not display a mark it would not be honestly
// "held" by.
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/types";
import IntertecLogo from "./IntertecLogo.astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="border-t border-hairline">
  <div
    class="mx-auto flex max-w-content flex-col items-start gap-2 px-gutter py-section-tight text-small text-muted lg:flex-row lg:items-center lg:justify-between"
  >
    <p class="inline-flex items-center gap-[0.4em]">
      <IntertecLogo
        label={t("footer.company")}
        class="h-[1.4em] w-auto shrink-0"
      />
      <span aria-hidden="true">·</span>
      <span>{t("footer.location")}</span>
    </p>
    <p>{t("footer.site")}</p>
  </div>
</footer>
