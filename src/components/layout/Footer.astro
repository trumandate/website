---
// Footer.astro — redesign wave A: the slim enterprise footer
// (docs/design_handoff_website_redesign/SiteFooter.dc.html /
// SiteFooterAR.dc.html), replacing the single-line P1 footer. Brand mark +
// "Powered by Intertec Systems · Dubai, UAE", the four page links, then a
// hairline row with the copyright.
//
// The email address, the "· trumandate.com" half of the trademark line and
// the footer's own language toggle were all removed on Piyush's call: each
// duplicated something already on the page (the contact route owns the
// address, the domain restates the URL bar, and the header carries the
// language toggle), so the footer keeps only what is not said elsewhere.
//
// The mark: same authoritative Echelons geometry as Header.astro's own
// (2026-08-19 user directive, BUILD_FLAGS.md decision log) — start-aligned
// pill bars, descending width, literal brand-teal/brand-green/brand-tile
// tokens, never jade/accent/paper.
//
// The reference's own footer draws "Intertec Systems"/"إنترتك سيستمز" as
// plain text, not the IntertecLogo.astro mark P9 introduced — reproduced
// exactly per the redesign's "match the reference pixel-for-pixel"
// priority. IntertecLogo.astro is left in the codebase, unreferenced
// rather than deleted: it is a distinct footer-branding feature from an
// earlier session, not an orphaned "old home component."
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/types";

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);

// Flat link list, matching the reference's own flat `<a>` row (no <nav><ul>
// wrapper — that's Header.astro's own pattern, with its underline-on-hover
// treatment; this footer's links are plain, per SiteFooter.dc.html).
const links = [
  { href: `/${lang}/strategy`, label: t("nav.strategy") },
  { href: `/${lang}/execution`, label: t("nav.execution") },
  { href: `/${lang}/benefits`, label: t("nav.benefits") },
  { href: `/${lang}/blog`, label: t("nav.blog") },
  { href: `/${lang}/contact`, label: t("nav.contact") },
];
---

<footer
  data-site-footer
  class="w-full border-t border-hairline bg-surface-deep"
>
  <div
    class="mx-auto max-w-content px-gutter"
    style="padding-block: clamp(2.25rem, 4vh, 3.5rem) 0;"
  >
    <div class="flex flex-wrap items-start justify-between gap-7">
      <div>
        <a
          href={`/${lang}/`}
          class="flex items-center gap-3"
          aria-label={t("brand.name")}
        >
          <svg
            viewBox="0 0 48 48"
            class="h-8 w-8"
            role="img"
            aria-hidden="true"
          >
            <rect width="48" height="48" rx="8.87" class="fill-brand-tile"></rect>
            <rect x="11.15" y="12.79" width="25.59" height="4.77" rx="2.385" class="fill-brand-teal"
            ></rect>
            <rect
              x="11.2"
              y="21.57"
              width="18.27"
              height="4.78"
              rx="2.39"
              class="fill-brand-green"></rect>
            <rect
              x="11.2"
              y="30.37"
              width="11.15"
              height="4.77"
              rx="2.385"
              class="fill-brand-green"></rect>
          </svg>
          <span class="font-sans text-h3 font-semi tracking-brand">
            <span class="text-accent">Tru</span><span class="text-paper"
              >Mandate</span
            >
          </span>
        </a>
        <p class="mt-4 font-mono text-datum font-data tracking-datum text-muted">
          {t("footer.poweredByPrefix")}<span class="text-paper"
            >{t("footer.company")}</span
          >{t("footer.poweredBySuffix")}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-x-7 gap-y-2.5">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-small font-light text-body transition-colors duration-state ease-standard hover:text-accent"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>

    <div
      class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2.5 border-t border-hairline-soft"
      style="margin-top: clamp(24px, 3vw, 36px); padding-block: 20px;"
    >
      <p class="m-0 font-mono text-datum font-data tracking-datum text-muted">
        {t("footer.copyright")}
      </p>
      <p
        dir="ltr"
        class="m-0 font-mono text-datum font-data tracking-datum text-muted"
      >
        {t("footer.trademark")}
      </p>
    </div>
  </div>
</footer>
