---
// Header.astro — fixed, hairline appears after 12px of scroll (motion #6,
// spec §7). Bilingual-ready (reads strings and direction from `lang`), but
// only /en exists as a real route until P5.
//
// The mark: the authoritative Echelons geometry (2026-08-19 user directive,
// BUILD_FLAGS.md decision log), re-authored as inline SVG from the product's
// own EchelonsLogo.tsx, measured against the 1173×1174 master — three
// start-aligned pill bars, descending width, top bar in the literal brand
// teal, the lower two in the literal brand green, on a light rounded tile.
// Colours are the dedicated brand-teal/brand-green/brand-tile tokens
// (tailwind.config.mjs), deliberately NOT jade/accent/paper — the brand doc
// treats this mark as a fixed asset, never restyled to site tokens. The PNG
// (and assets/TruMandate_Product_deck_2pager.pptx) are reference-only and
// never ship.
//
// The wordmark is two-tone per the product deck's brand direction, expressed
// in tokens rather than the deck's own hexes: "Tru" in `accent`, "Mandate"
// in the heading colour for this (dark) surface, `paper`. The primary CTA
// uses the shared Button.astro (built at P2, TODO.md).
//
// Wordmark text is `hidden sm:inline` (P8 fix, known-issues.md): at 375 the
// logomark + language toggle + a non-wrapping, non-shrinking CTA (Button's
// own P8 fix) don't all fit alongside the full "TruMandate" text lockup in
// either language — measured ~57px short in English, ~37px short in Arabic.
// Below the `sm` breakpoint (640px, a stock Tailwind default, no bespoke
// screen added) only the icon shows; the link's `aria-label` already carries
// the full brand name for assistive tech regardless of what's visually
// rendered, so this is a display-only change, not a content change.
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/types";
import Nav from "./Nav.astro";
import LangToggle from "./LangToggle.astro";
import Button from "../ui/Button.astro";
import NavDrawer from "./NavDrawer.astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-header bg-ink/veil backdrop-blur-veil"
>
  <!-- gap-6 between the three groups, not gap-gutter (USER REPORT 2026-09-01,
       known-issues.md): justify-between already spreads the groups, so the
       gap is only a collision floor — at 72px it helped the five-link nav
       overflow the grid. 24px keeps the floor without ever binding at lg+. -->
  <div
    class="mx-auto flex max-w-content items-center justify-between gap-6 px-gutter py-4"
  >
    <a
      href={`/${lang}/`}
      data-header-brand
      class="flex items-center gap-3"
      aria-label={t("brand.name")}
    >
      <svg viewBox="0 0 48 48" class="h-8 w-8" role="img" aria-hidden="true">
        <rect width="48" height="48" rx="8.87" class="fill-brand-tile"></rect>
        <rect x="11.15" y="12.79" width="25.59" height="4.77" rx="2.385" class="fill-brand-teal"
        ></rect>
        <rect x="11.2" y="21.57" width="18.27" height="4.78" rx="2.39" class="fill-brand-green"
        ></rect>
        <rect x="11.2" y="30.37" width="11.15" height="4.77" rx="2.385" class="fill-brand-green"
        ></rect>
      </svg>
      <span class="hidden font-sans text-h3 font-semi tracking-brand sm:inline">
        <span class="text-accent">Tru</span><span class="text-paper"
          >Mandate</span
        >
      </span>
    </a>

    <div class="hidden items-center gap-gutter lg:flex">
      <Nav lang={lang} />
    </div>

    <div class="hidden items-center gap-6 lg:flex">
      <LangToggle lang={lang} />
      <Button href={`/${lang}/contact`}>{t("cta.primary")}</Button>
    </div>

    <!-- P11 (USER REPORT fix): below `lg` the two blocks above are
         `display:none`, so without this trigger Strategy/Execution/Benefits/
         Contact — and, until now, the language toggle and CTA too — had no
         way into the header at all on phones and most tablets. This button
         is the only new element in the `lg`+ layout's DOM; it's `lg:hidden`,
         so it renders nothing there and the desktop header is byte-for-byte
         the same markup as before this change. `aria-expanded`/`aria-label`
         are toggled by scripts/mobileNav.ts; the two label strings travel as
         data attributes so that script never hardcodes copy in either
         language (same contract scripts/recordChain.ts already uses for
         `data-chain-names`). -->
    <button
      type="button"
      data-nav-trigger
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      aria-label={t("nav.openMenu")}
      data-label-open={t("nav.openMenu")}
      data-label-close={t("nav.closeMenu")}
      class="nav-trigger -m-3 inline-flex items-center justify-center rounded-control p-3 text-paper transition-colors duration-micro ease-micro hover:text-accent lg:hidden"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path
          data-bar="top"
          d="M4 7h16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
        <path
          data-bar="mid"
          d="M4 12h16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
        <path
          data-bar="bottom"
          d="M4 17h16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>

    <!-- CLAUDE.md: "the site must be readable with JavaScript disabled." The
         drawer this button opens is entirely JS-driven (open/close, focus
         trap, inert toggling) — a no-JS reader who saw it would find a
         button that does nothing, with no other way to reach Strategy/
         Execution/Benefits from the header. Hiding it here (same
         BaseLayout.astro `<noscript>` idiom already used for the `.tm-*`
         motion classes) removes the dead control; Footer.astro's own four
         links (never conditional on JS) are the real no-JS path to those
         routes, verified by reading that component — it renders plain
         `<a>` tags unconditionally. -->
    <noscript>
      <style>
        [data-nav-trigger] {
          display: none !important;
        }
      </style>
    </noscript>
  </div>
</header>

<NavDrawer lang={lang} />

<style>
  [data-header] {
    position: fixed;
    /* P10 (DESIGN-ELEVATION.md §3.2): the scrolled state separates chrome
     * from content by light, not just a line — same duration/ease pair the
     * hairline opacity below already uses. */
    box-shadow: none;
    transition: box-shadow theme("transitionDuration.header")
      theme("transitionTimingFunction.standard");
  }

  [data-header]::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    block-size: 1px;
    background-color: theme("colors.hairline");
    opacity: 0;
    transition: opacity theme("transitionDuration.header")
      theme("transitionTimingFunction.standard");
  }

  [data-header].is-scrolled {
    box-shadow: theme("boxShadow.chrome");
  }

  [data-header].is-scrolled::after {
    opacity: 1;
  }

  /* Hamburger → X, driven off the trigger's own `aria-expanded` — reading
   * real state instead of a duplicate `.is-open` class, same economy as
   * `[data-nav-drawer].is-open` in NavDrawer.astro (that one needs a class
   * because a CSS attribute selector can't reach across into a *different*
   * element's state; this one doesn't need to, so it doesn't get one).
   * Transform + opacity only, no layout properties, per CLAUDE.md. */
  .nav-trigger path {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-trigger path {
      transition:
        transform theme("transitionDuration.micro")
          theme("transitionTimingFunction.micro"),
        opacity theme("transitionDuration.micro")
          theme("transitionTimingFunction.micro");
    }
  }

  .nav-trigger[aria-expanded="true"] path[data-bar="top"] {
    transform: translateY(5px) rotate(45deg);
  }

  .nav-trigger[aria-expanded="true"] path[data-bar="mid"] {
    opacity: 0;
  }

  .nav-trigger[aria-expanded="true"] path[data-bar="bottom"] {
    transform: translateY(-5px) rotate(-45deg);
  }
</style>

<script src="../../scripts/header.ts"></script>
<script src="../../scripts/mobileNav.ts"></script>
