---
// Nav.astro — Strategy / Execution / Benefits / Contact, mirroring the five
// routes (BUILD_FLAGS decisions log, P0 gate). The content brief's
// prototype-era nav ("Traceability / Platform / AI / Contact") is
// deliberately not used: there is no "Platform" or "AI" route, and spec §1
// is explicit that there is no single "AI" page.
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/types";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: `/${lang}/strategy`, label: t("nav.strategy") },
  { href: `/${lang}/execution`, label: t("nav.execution") },
  { href: `/${lang}/benefits`, label: t("nav.benefits") },
  { href: `/${lang}/blog`, label: t("nav.blog") },
  { href: `/${lang}/contact`, label: t("nav.contact") },
];
---

<nav aria-label="Primary">
  <!-- gap-10, not gap-gutter (USER REPORT 2026-09-01, known-issues.md): with
       the Blog link the five labels plus four 72px gutter gaps overflowed the
       header grid by 34.4px at every lg+ width, pushing the CTA past the
       content edge on every route (and putting the whole row into negative
       flex space — the pressure behind the vanishing brand mark). Four 40px
       gaps keep the row inside its 1036px budget with room for both
       languages' label widths. -->
  <ul class="flex items-center gap-10">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-link relative text-small font-semi tracking-brand text-paper transition-colors duration-state ease-standard hover:text-accent"
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* P10 (DESIGN-ELEVATION.md §3.8): a 1px underline grows from the
   * inline-start edge on hover/focus, CSS-only (works with JavaScript
   * disabled, per the motion dossier's own recommendation over a GSAP hover
   * tween). Transform-origin flip, not a physical `origin-*` utility — the
   * pattern SuggestionCard.astro already established at P5 for the same
   * "horizontal motion mirrors under RTL" rule (spec §8). */
  .nav-link::after {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    bottom: -0.25rem;
    inline-size: 100%;
    block-size: 1px;
    background-color: theme("colors.accent");
    transform: scaleX(0);
    transform-origin: 0% 50%;
  }

  :global([dir="rtl"]) .nav-link::after {
    transform-origin: 100% 50%;
  }

  /* motion-safe: equivalent, hand-authored because the transition targets a
   * pseudo-element rather than a utility class. Under `reduce`, no rule here
   * sets `transition`, so the hover/focus `scaleX(1)` below still applies —
   * instantly, with no animated step. */
  @media (prefers-reduced-motion: no-preference) {
    .nav-link::after {
      transition: transform theme("transitionDuration.micro")
        theme("transitionTimingFunction.micro");
    }
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }
</style>
