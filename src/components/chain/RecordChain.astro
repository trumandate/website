---
// RecordChain.astro — THE SIGNATURE (redesign wave A, Home (redesign).dc.html
// §5 / README §5). 480vh section, sticky 100vh stage. Five record cards
// orbit on an ellipse driven by scripts/recordChain.ts's scroll handler —
// see that file for the exact math (x/z/y/opacity formulas, dwell-then-
// glide easing, RTL rotation-sign reversal).
//
// This is the site's one pinned section + one scrubbed "timeline" per route
// (CLAUDE.md's budget) — the pin is plain CSS `position: sticky` (same
// choice the pre-redesign chain.ts made, and the same reasoning: a sticky
// element's pinned range can never exceed its own containing block's
// natural height, so nothing is manufactured), and the scrub is a scroll
// handler writing transforms directly, not a GSAP ScrollTrigger tween — see
// recordChain.ts's own header comment for why, and for the reduced-motion
// contract (setup never runs under reduce; the five cards render in normal
// document flow, stacked, fully legible, which is also exactly what a JS
// failure produces).
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/types";

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);

interface Record {
  name: string;
  kicker: string;
  title: string;
  body: string;
  row1Label: string;
  row1Value: string;
  row2Label: string;
  row2Value: string;
  dotClass: string;
  row1ValueClass?: string;
  row2ValueClass?: string;
}

const records: Record[] = [
  {
    name: t("home.chain.record1Name"),
    kicker: t("home.chain.record1Kicker"),
    title: t("home.chain.record1Title"),
    body: t("home.chain.record1Body"),
    row1Label: t("home.chain.record1Row1Label"),
    row1Value: t("home.chain.record1Row1Value"),
    row2Label: t("home.chain.record1Row2Label"),
    row2Value: t("home.chain.record1Row2Value"),
    dotClass: "bg-accent",
  },
  {
    name: t("home.chain.record2Name"),
    kicker: t("home.chain.record2Kicker"),
    title: t("home.chain.record2Title"),
    body: t("home.chain.record2Body"),
    row1Label: t("home.chain.record2Row1Label"),
    row1Value: t("home.chain.record2Row1Value"),
    row2Label: t("home.chain.record2Row2Label"),
    row2Value: t("home.chain.record2Row2Value"),
    dotClass: "bg-cyan",
    row2ValueClass: "text-cyan",
  },
  {
    name: t("home.chain.record3Name"),
    kicker: t("home.chain.record3Kicker"),
    title: t("home.chain.record3Title"),
    body: t("home.chain.record3Body"),
    row1Label: t("home.chain.record3Row1Label"),
    row1Value: t("home.chain.record3Row1Value"),
    row2Label: t("home.chain.record3Row2Label"),
    row2Value: t("home.chain.record3Row2Value"),
    dotClass: "bg-accent",
  },
  {
    name: t("home.chain.record4Name"),
    kicker: t("home.chain.record4Kicker"),
    title: t("home.chain.record4Title"),
    body: t("home.chain.record4Body"),
    row1Label: t("home.chain.record4Row1Label"),
    row1Value: t("home.chain.record4Row1Value"),
    row2Label: t("home.chain.record4Row2Label"),
    row2Value: t("home.chain.record4Row2Value"),
    dotClass: "bg-amber",
    row1ValueClass: "text-gold",
  },
  {
    name: t("home.chain.record5Name"),
    kicker: t("home.chain.record5Kicker"),
    title: t("home.chain.record5Title"),
    body: t("home.chain.record5Body"),
    row1Label: t("home.chain.record5Row1Label"),
    row1Value: t("home.chain.record5Row1Value"),
    row2Label: t("home.chain.record5Row2Label"),
    row2Value: t("home.chain.record5Row2Value"),
    dotClass: "bg-gold",
  },
];

// Data handed to recordChain.ts via a JSON script tag rather than inline
// `data-*` parsing — the record names double as the sticky counter's live
// name swap, exactly like the reference's own `chainNames` array.
const chainNames = records.map((r) => r.name);
---

<section
  id="record"
  data-chain
  data-rtl={lang === "ar" ? "true" : "false"}
  class="relative w-full"
  style="height: 480vh;"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0">
    <div class="absolute inset-0 bg-surface-deep"></div>
  </div>

  <div
    data-chain-stage
    class="relative z-10 flex flex-col justify-center overflow-hidden"
    style="position: sticky; top: 0; min-height: 100vh; min-height: 100svh;"
  >
    {
      /* BUGFIX (USER REPORT "when I go to 4th and 5th panes during
      scrolling, I can't see the rest of it"): this stage's CONTENT height
      (heading block + gaps + counter + track) used to be a flat ~738px no
      matter the viewport — `min-h-screen` is only a 100vh FLOOR, not a
      ceiling, so on any viewport shorter than that a sticky `top:0` element
      can't stay genuinely pinned: its own box is taller than the screen, so
      the browser is forced to slide it upward once the containing 480vh
      section's remaining scroll room runs out, by exactly (content height −
      viewport height) — measured 118px of drift at 1366×620, confirmed via
      getBoundingClientRect() before this fix. That drift shows the stage's
      BOTTOM half (the scroll-down hint, the lower part of the composition)
      earlier in the scrub and hides the TOP half (this heading) later —
      which is the "can't see the rest of it" the user is describing; two
      different things go off-screen depending on how far you've scrolled.
      Every measurement below is keyed to `svh` (small viewport height, the
      same reasoning as BaseLayout's own `100svh` body height — matches what
      is actually visible before a mobile browser's chrome collapses, not
      the larger `100vh`/`lvh`), not a handful of tested breakpoints, so the
      composition keeps shrinking continuously as height shrinks rather than
      snapping between fixed states, and the invariant (content ≤ viewport)
      holds by construction rather than by having guessed every device.
      Below ~720px of height the lede is the first thing dropped (data-chain-
      lede) — supplementary copy, not load-bearing; below ~620px the whole
      heading block goes (data-chain-heading) — at that point there simply
      isn't room for a heading, the counter and the record card, above a
      phone's on-screen keyboard, without shrinking the card itself past
      legibility (the card's own real rendered height, not a guessed number,
      is what recordChain.ts's CSS-grid overlay now sizes the track to — see
      its own comment). This is CLAUDE.md's "reduce the heading block's
      contribution when height is scarce" lever, not the more drastic
      "un-pin the heading" restructure (that one was tried on paper first:
      even fully compressed, heading + counter + a legible card already
      exceeds 580px of height, i.e. before the extreme end of this range —
      hiding beats a redesign here). Reduced-motion is untouched by any of
      this: `armRing` (recordChain.ts) — which is the only thing that ever
      switches the cards out of normal flow — never runs under
      `prefers-reduced-motion: reduce`, and the hide rules below are
      themselves gated on `(prefers-reduced-motion: no-preference)`, so a
      reduced-motion reader still gets the full heading and five
      normal-flow, fully legible, stacked cards, exactly as before — that
      page is allowed to simply be tall and scroll (global.css). */
    }
    <div class="mx-auto w-full max-w-content px-gutter">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div data-chain-heading>
          <p class="font-mono text-eyebrow font-data uppercase tracking-eyebrow text-muted">
            {t("home.chain.eyebrow")}
          </p>
          <h2
            class="mt-4 max-w-[26ch] font-sans text-h2 font-semi tracking-heading text-paper"
            style="text-wrap: pretty;"
          >
            {t("home.chain.heading")}
          </h2>
          <p data-chain-lede class="mt-4 max-w-measure-tight text-lede font-light text-body">
            {t("home.chain.sub")}
          </p>
        </div>
      </div>
    </div>

    <div class="relative" style="margin-top: clamp(12px, 5svh, 56px);">
      <div
        aria-hidden="true"
        class="relative text-center"
        style="z-index: 5; margin-bottom: clamp(6px, 2.5svh, 24px);"
      >

        <p
          dir="ltr"
          data-chain-count
          class="m-0 font-mono font-data tracking-datum text-muted"
          style="font-size: 13px;"
        >
          01 / 05
        </p>
        <p
          data-chain-name
          class="text-mint font-sans text-h3 font-semi tracking-heading"
          style="margin: 4px 0 0;"
        >
          {records[0].name}
        </p>
      </div>

      <div style="perspective: 1500px; perspective-origin: 50% 42%;">
        <div
          data-chain-track
          class="relative mx-auto"
          style="width: min(78vw, 340px); min-height: clamp(96px, 48svh, 430px); transform-style: preserve-3d; will-change: transform;"
        >
          {
            records.map((record) => (
              <div
                data-chain-card
                class="relative"
                style="width: min(78vw, 340px); padding-top: 26px;"
              >
                <span
                  aria-hidden="true"
                  data-chain-dot
                  class:list={["absolute top-0 rounded-full", record.dotClass]}
                  style="inset-inline-start: 0; width: 13px; height: 13px;"
                />
                <p class="font-mono text-datum font-data tracking-datum text-muted">
                  {record.kicker}
                </p>
                <div class="mt-3 rounded-card border border-hairline bg-surface p-5 shadow-raised">
                  <h3 class="font-sans text-h3 font-semi tracking-heading text-paper">
                    {record.title}
                  </h3>
                  <p class="mt-2 text-small font-light text-body">{record.body}</p>
                  <div class="mt-3.5">
                    <div class="flex items-center justify-between gap-3 border-t border-hairline py-2">
                      <span class="font-mono text-datum font-data tracking-datum text-muted">
                        {record.row1Label}
                      </span>
                      <span
                        dir="ltr"
                        class:list={[
                          "font-mono text-datum font-data tracking-datum",
                          record.row1ValueClass ?? "text-paper",
                        ]}
                      >
                        {record.row1Value}
                      </span>
                    </div>
                    <div class="flex items-center justify-between gap-3 border-t border-hairline py-2">
                      <span class="font-mono text-datum font-data tracking-datum text-muted">
                        {record.row2Label}
                      </span>
                      <span
                        dir="ltr"
                        class:list={[
                          "font-mono text-datum font-data tracking-datum",
                          record.row2ValueClass ?? "text-paper",
                        ]}
                      >
                        {record.row2Value}
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    {
      /* Scroll-down nudge (USER REQUEST): the ellipse above moves cards
      horizontally through 3D space, so nothing else on this stage signals
      that continuing to scroll *down* is what advances it — a reader can
      stall on the first card. Five static ticks (one per record, echoing
      the "01 / 05" counter/name block just above) plus one travelling
      highlight that drifts from the first tick to the last and fades: a
      quiet wayfinding cue, not a bare arrow, and never a pulse or a bounce
      (see global.css's tm-hint-drift comment for the full motion contract).

      Decorative only — aria-hidden, no i18n string, nothing an assistive-
      tech reader would need (the chain's own content is already exposed in
      normal document flow). Served hidden (global.css); recordChain.ts's
      existing onScroll handler reveals it once the pinned stage becomes the
      reader's context and permanently dismisses it once they've actually
      advanced the chain, reusing the scroll-progress value it already
      computes rather than a second scroll listener. Positioned with
      inset-inline + margin-inline (not a translateX(-50%) centering hack)
      specifically because that hack's sign flips under RTL — this way is
      direction-agnostic by construction, verified in both languages.

      Prominence pass (USER FEEDBACK "very subtle"): rail/ticks/bead scaled
      up 2x uniformly (36px→72px rail, 3px→6px ticks, 7px→14px bead) so
      every original proportion (tick:bead:rail ratios) is preserved exactly
      rather than redrawn; tick opacity raised 0.40→0.60; the bead gained a
      static mint halo (shadow-hint-glow, tailwind.config.mjs — reuses the
      existing `mint-ring` live-pulse token, not a new hex) that is never
      itself animated, only ever carried along by the bead's own opacity
      keyframe. See global.css's tm-hint-drift for the widened visible
      window. */
    }
    <div
      data-chain-hint
      aria-hidden="true"
      class="pointer-events-none absolute z-30"
      style="inset-inline: 0; inset-block-end: clamp(16px, 3.5vh, 28px); width: fit-content; margin-inline: auto;"
    >
      <span class="relative block" style="width: 14px; height: 72px;">
        {
          [0, 25, 50, 75, 100].map((pct) => (
            <span
              class="absolute rounded-full bg-muted opacity-60"
              style={`inset-block-start: ${pct}%; inset-inline: 0; width: 6px; height: 6px; margin-inline: auto; transform: translateY(-50%);`}
            />
          ))
        }
        <span
          data-chain-hint-glow
          class="absolute rounded-full bg-mint shadow-hint-glow"
          style="inset-block-start: 0; inset-inline: 0; width: 14px; height: 14px; margin-inline: auto; transform: translateY(-50%);"
        />
      </span>
    </div>
  </div>
</section>

<style>
  /* Short-viewport fix (see the `data-chain-stage` comment above for the
   * full reasoning) — two content-priority steps, each a plain max-height
   * media query as CLAUDE.md sanctions for exactly this ("a `@media
   * (max-height: …)` branch is legitimate and is the standard tool"), gated
   * out entirely under reduced motion so that branch (global.css) keeps
   * showing the complete heading and all five stacked cards untouched.
   * Thresholds come from this component's own measured worst case (Arabic,
   * widest layout): heading block ≈738px total today, the lede alone ≈
   * 60–90px of that, the eyebrow+heading remainder ≈150–235px — so lede-only
   * survives down to where a full heading would start clipping (~720px),
   * and the whole block is dropped only where even that remainder plus the
   * counter plus a real (grid-measured, not guessed) card would still not
   * fit (~620px). */
  @media (prefers-reduced-motion: no-preference) and (max-height: 720px) {
    [data-chain-lede] {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (max-height: 620px) {
    [data-chain-heading] {
      display: none;
    }
  }
</style>

<script type="application/json" data-chain-names is:inline set:html={JSON.stringify(chainNames)} />
<script src="../../scripts/recordChain.ts"></script>
