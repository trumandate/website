---
// ArgumentBlock.astro — redesign wave B, part 3 of the shared skeleton
// (Strategy/Execution/Benefits (redesign).dc.html §3, "The argument"
// section). Replaces the pre-redesign paragraph stack wholesale: the
// reference's own shape is a muted eyebrow + heading, then a three-column
// grid — each column a `tm-grow` hairline rule, a hue-coloured mono eyebrow
// naming the point ("The break" / "The join" / "The refusal", and the two
// Execution/Benefits sibling triads), and two sentences of body copy. Ported
// near-verbatim: every class below already exists in this repo's compiled
// Tailwind. Self-contained (owns its own `<Section ground="deep" seam="down">`
// — the reference's own `bg-surface-deep` + `bg-seam-down` backdrop, both of
// which `Section.astro`'s existing props already produce, needing no custom
// `backdrop` Fragment).
//
// `tm-rise`/`tm-grow` (not `Reveal.astro`'s GSAP `.from()`): this section's
// motion is IntersectionObserver + CSS-transition driven
// (scripts/redesignReveal.ts), matching the reference's own inline script
// and Wave A's home-page precedent — no GSAP tween competes with a CSS
// `transition` here, sidestepping the P10 stagger-freeze class of bug by
// construction.
import Section from "../layout/Section.astro";
import type { ProductArgument, ProductPageCopy } from "./copy";

interface Props {
  argument: ProductArgument;
  hue: ProductPageCopy["hue"];
}

const { argument, hue }: Props = Astro.props;

const hueTextClass: Record<ProductPageCopy["hue"], string> = {
  cyan: "text-cyan",
  mint: "text-mint",
  gold: "text-gold",
};

const delays = [undefined, "130ms", "260ms"];
---

<Section ground="deep" seam="down">
  <div class="tm-rise">
    <p class="font-mono text-eyebrow font-data uppercase tracking-eyebrow text-muted">
      {argument.eyebrow}
    </p>
    <h2
      class="mt-4 font-sans text-h2 font-semi tracking-heading text-paper"
      style={`max-width: ${argument.headingMaxCh}ch; text-wrap: pretty;`}
    >
      {argument.heading}
    </h2>
  </div>
  <div
    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: clamp(20px, 3vw, 48px); margin-top: clamp(32px, 4vw, 56px);"
  >
    {
      argument.points.map((point, index) => (
        <div class="tm-rise" style={delays[index] ? `--d: ${delays[index]};` : undefined}>
          <hr
            class="tm-grow"
            style="margin: 0; border: 0; border-top: 1px solid rgba(255,255,255,0.10);"
          />
          <p
            class:list={[
              "font-mono text-eyebrow font-data uppercase tracking-eyebrow",
              hueTextClass[hue],
            ]}
            style="margin: 20px 0 0;"
          >
            {point.eyebrow}
          </p>
          <p class="mt-3 text-body font-light text-body">{point.body}</p>
        </div>
      ))
    }
  </div>
</Section>
