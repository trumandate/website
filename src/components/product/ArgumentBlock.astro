---
// ArgumentBlock.astro — part 2 of the shared product-page skeleton
// (trumandate-product-pages.md): "three to four paragraphs, no bullets, no
// cards. This is the page's substance and the reason a serious reader
// stays."
//
// Deliberately has no heading of its own and no internal structure beyond
// paragraph spacing. Every temptation to break this into labelled blocks,
// pull-quotes or a two-column split is the same temptation the product-pages
// doc rules out by naming the format exactly; a reader who wants scannable
// bullets is not the reader this page is written for.
//
// Capped at `measure` (56ch, tailwind.config.mjs) rather than the 1180px
// column, so the line length stays readable at 1440 — the same cap
// Lede.astro applies.
//
// P10 (DESIGN-ELEVATION.md §4.3), three moves, none of them a new type role:
//   (a) a full-width `hairline-soft` <Rule> between the page's <h1> (rendered
//       by ProductPage.astro, immediately above this component) and the
//       first paragraph — "acknowledges the column change" from the wide
//       header to the narrow measure-capped prose, rather than leaving the
//       inline-end half of the viewport looking like text that failed to
//       fill its space. Rendered at this component's own root, OUTSIDE the
//       `max-w-measure` wrapper below, so it spans the full content column
//       (1180px) rather than the 56ch measure.
//   (b) the first paragraph takes the `lede` size step in `text-paper`
//       (critique finding #4's fix, applied where the site has the most
//       text); paragraphs 2–n stay at `body`/`text-body`.
//   (c) the paragraph stack becomes a `data-reveal-group` staggered at 0.08s
//       (longer than the 0.06 default — "these are long blocks and the
//       reader dwells," §4.3c) via reveal.ts's `data-stagger` override,
//       separate from the eyebrow+h1's own standard <Reveal> in
//       ProductPage.astro (that Reveal wraps only the eyebrow/h1 now; this
//       group is its own sibling trigger, matching FailureModes.astro's
//       established intro-Reveal / group-stagger split).
//
// Reduced motion: `[data-reveal-group] > *` (global.css) is the group's
// unconditional CSS end state — every paragraph visible at full opacity,
// the rule present, the first paragraph at its larger size — identical with
// JS disabled.
import Rule from "../ui/Rule.astro";

interface Props {
  paragraphs: string[];
  class?: string;
}

const { paragraphs, class: className }: Props = Astro.props;
---

<div class:list={[className]}>
  <Rule soft class="mb-8" />
  <div class="max-w-measure" data-reveal-group data-stagger="0.08">
    {
      paragraphs.map((paragraph, index) => (
        <p
          class:list={[
            index === 0
              ? "text-lede font-light text-paper"
              : "text-body font-light text-body",
            index > 0 && "mt-6",
          ]}
        >
          {paragraph}
        </p>
      ))
    }
  </div>
</div>
