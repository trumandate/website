---
// Handoff.astro — redesign wave B, part 5 of the shared skeleton
// (Strategy/Execution/Benefits (redesign).dc.html §5, "Handoff"). One
// sentence (plus, on two of the three pages, a second lede line) naming the
// withheld item, then two CTAs: "Book a demo" and a ghost "Next: X" / "Back
// to home" link. Self-contained (owns its own `<Section>`); the grid-draft +
// `bg-ground-board` backdrop is the same composition `ClosingCta.astro`
// already established for the home page's own closing section — reused
// verbatim rather than re-derived, since both are the same "grid ground,
// board glow" treatment from the same reference vocabulary. Uses the default
// `py-section` rhythm (the reference's own handoff section carries no
// bespoke padding, unlike the hero/fragment sections).
//
// Replaces the pre-redesign version wholesale: that file rendered a single
// CTA in a `border-t` rule shape (DESIGN-ELEVATION §4.4's "rhyme with
// /contact" treatment) with no secondary link — the new reference always
// pairs the primary CTA with a same-row secondary "Next" link, and drops the
// hairline-rule frame for the grid-ground backdrop instead.
import Section from "../layout/Section.astro";
import Button from "../ui/Button.astro";
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/types";
import type { ProductHandoff, ProductPageCopy } from "./copy";

interface Props {
  lang: Language;
  hue: ProductPageCopy["hue"];
  handoff: ProductHandoff;
}

const { lang, hue, handoff }: Props = Astro.props;
const t = useTranslations(lang);

const hueTextClass: Record<ProductPageCopy["hue"], string> = {
  cyan: "text-cyan",
  mint: "text-mint",
  gold: "text-gold",
};
---

<Section>
  <Fragment slot="backdrop">
    <div
      class="absolute inset-0 bg-grid-draft"
      style="mask-image: linear-gradient(to bottom, transparent 0%, black 18%, black 82%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 18%, black 82%, transparent 100%);"
    >
    </div>
    <div class="absolute inset-0 bg-ground-board"></div>
  </Fragment>

  <div class="tm-rise" style="max-width: 62ch;">
    <p
      class:list={[
        "font-mono text-eyebrow font-data uppercase tracking-eyebrow",
        hueTextClass[hue],
      ]}
    >
      {handoff.eyebrow}
    </p>
    <h2
      class="mt-4 font-sans text-h2 font-semi tracking-heading text-paper"
      style="text-wrap: pretty;"
    >
      {handoff.heading}
    </h2>
    {
      handoff.lede && (
        <p class="mt-5 text-lede font-light text-body">{handoff.lede}</p>
      )
    }
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button href={`/${lang}/contact`} style="min-height: 46px; padding-inline: 24px;">
        {t("cta.primary")}
      </Button>
      <Button
        variant="ghost"
        href={`/${lang}${handoff.nextHref}`}
        style="min-height: 46px; padding-inline: 24px;"
      >
        {handoff.nextLabel}
      </Button>
    </div>
  </div>
</Section>
