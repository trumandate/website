---
// ProductPage.astro — redesign wave B. The shared five-part skeleton for
// /strategy, /execution and /benefits (docs/design_handoff_website_redesign/
// README.md §§2–4), replacing the pre-redesign version wholesale: the new
// reference pages share a different shape (start-aligned hero with a
// gradient key phrase, a bespoke fragment, a three-point argument grid, a
// single hue-bordered AI card, a two-CTA handoff) from the old one (centred
// argument paragraphs, `SuggestionCard.astro`), so "every product page uses
// this order, no page invents a new structure" is re-enforced here against
// the NEW order rather than the old one. Each of the three pages still
// supplies only two things: which `ProductPageCopy` object (copy.ts) and
// which fragment.
//
// The five parts, four of which are self-contained sub-components (each
// owns its own `<Section>`, matching `home/Hero.astro`/`ClosingCta.astro`'s
// precedent): `ProductHero` (part 1) → the fragment, wrapped here directly
// since it's the one part with no shared markup beyond the crop padding →
// `ArgumentBlock` (part 3) → the AI moment (part 4, assembled here: a
// `Section seam="up"` two-column grid pairing plain text with
// `AiMomentCard`) → `Handoff` (part 5).
//
// Motion: `.tm-load`/`.tm-boardload` (pure CSS, no script) for the hero and
// fragment; `.tm-rise`/`.tm-grow` (IntersectionObserver + CSS transition,
// scripts/redesignReveal.ts) for everything below the fold — the calling
// page wires that one script tag once, matching `pages/en/index.astro`'s own
// pattern. No pinned section, no scrubbed timeline, no count-up (CLAUDE.md's
// one-pin-one-scrub-per-route budget is spent on the home page's chain).
import Section from "../layout/Section.astro";
import ProductHero from "./ProductHero.astro";
import ArgumentBlock from "./ArgumentBlock.astro";
import AiMomentCard from "./AiMomentCard.astro";
import Handoff from "./Handoff.astro";
import type { ProductPageCopy } from "./copy";
import type { Language } from "../../i18n/types";

interface Props {
  lang: Language;
  copy: ProductPageCopy;
}

const { lang, copy }: Props = Astro.props;
---

<ProductHero lang={lang} copy={copy} />

{/* Part 3 (fragment half): one cropped fragment and a two-line-worth mono
    caption, nothing else in the section. Bespoke bottom-only padding, no
    padding-top — the reference sits this directly under the hero. */}
<Section pad={false} style="padding-bottom: clamp(2rem, 4vh, 3rem);">
  <slot name="fragment" />
</Section>

<ArgumentBlock argument={copy.argument} hue={copy.hue} />

{/* Part 4: the AI moment. Text column + the hue-bordered card. */}
<Section seam="up">
  <div
    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: clamp(24px, 4vw, 64px); align-items: center;"
  >
    <div class="tm-rise">
      <p class="font-mono text-eyebrow font-data uppercase tracking-eyebrow text-muted">
        {copy.ai.eyebrow}
      </p>
      <h2
        class="mt-4 font-sans text-h2 font-semi tracking-heading text-paper"
        style={`max-width: ${copy.ai.headingMaxCh}ch; text-wrap: pretty;`}
      >
        {copy.ai.heading}
      </h2>
      <p class="mt-6 text-body font-light text-body" style="max-width: 52ch;">
        {copy.ai.body}
      </p>
    </div>
    <AiMomentCard lang={lang} hue={copy.hue} ai={copy.ai} />
  </div>
</Section>

<Handoff lang={lang} hue={copy.hue} handoff={copy.handoff} />
