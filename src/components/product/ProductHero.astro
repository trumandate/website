---
// ProductHero.astro — redesign wave B, part 1 of the shared skeleton
// (Strategy/Execution/Benefits (redesign).dc.html §1). Start-aligned hero:
// grid-draft + ground-rise backdrop, a hue-coloured mono chain eyebrow, a
// display H1 with a gradient-clip key phrase, a lede, one primary CTA.
// Ported near-verbatim from the reference's own markup/classes — every class
// here already exists in this repo's compiled Tailwind (the reference shares
// this project's own `_ds_bundle.css`, per the handoff README). Self-
// contained (owns its own `<Section bleed pad={false}>`), matching
// `home/Hero.astro`'s own precedent for a section with bespoke
// `padding-top`/`padding-bottom` rather than the shared `py-section` rhythm.
//
// The load cascade (`.tm-load`, global.css) is pure CSS `animation` — it
// needs no IntersectionObserver and runs (then is neutralised) identically
// under `prefers-reduced-motion: reduce` and JS-disabled (BaseLayout.astro's
// `<noscript>` block), so this component wires no script of its own.
//
// The gradient key-phrase span reads its two stops from tailwind.config.mjs
// at build time (no hex literal here) — same pattern BaseLayout.astro uses
// for `theme-color`, needed because a CSS `background: linear-gradient(...)`
// has no Tailwind-utility equivalent. Angle flips 92deg → 268deg under RTL,
// matching the reference's own AR files exactly (the existing
// `gradient-text(-rtl)` tokens are hardcoded to the home hero's accent→cyan
// pair; this generalises the same angle convention to the mint/gold pairs
// Execution/Benefits need).
import Section from "../layout/Section.astro";
import Button from "../ui/Button.astro";
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/types";
import type { ProductPageCopy } from "./copy";
import tailwindConfig from "../../../tailwind.config.mjs";

interface Props {
  lang: Language;
  copy: ProductPageCopy;
}

const { lang, copy }: Props = Astro.props;
const t = useTranslations(lang);
const isAr = lang === "ar";

const colors = (tailwindConfig as { theme: { colors: Record<string, string> } })
  .theme.colors;

const gradientFrom = copy.hue === "gold" ? colors.amber : colors.accent;
const gradientTo = colors[copy.hue];
const gradientAngle = isAr ? 268 : 92;
const gradientStyle = `background: linear-gradient(${gradientAngle}deg, ${gradientFrom} 0%, ${gradientTo} 100%); -webkit-background-clip: text; background-clip: text; color: transparent;`;

const hueTextClass: Record<ProductPageCopy["hue"], string> = {
  cyan: "text-cyan",
  mint: "text-mint",
  gold: "text-gold",
};
---

<Section bleed pad={false}>
  <Fragment slot="backdrop">
    <div class="absolute inset-0 bg-ground-rise"></div>
    <div
      class="absolute inset-0 bg-grid-draft"
      style="mask-image: linear-gradient(to bottom, transparent 0%, black 12%, black 80%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 12%, black 80%, transparent 100%);"
    >
    </div>
  </Fragment>

  <div
    class="relative z-10 mx-auto max-w-content px-gutter"
    style="padding-top: clamp(3.5rem, 8vh, 6rem); padding-bottom: clamp(2rem, 4vh, 3rem);"
  >
    <p
      class:list={[
        "tm-load font-mono text-eyebrow font-data uppercase tracking-eyebrow",
        hueTextClass[copy.hue],
      ]}
    >
      {copy.chainEyebrow}
    </p>
    <h1
      class="tm-load mt-5 font-sans text-display font-semi tracking-display text-paper lg:tracking-display-lg"
      style={`--d: 90ms; max-width: ${copy.heroHeadlineMaxCh}ch; text-wrap: balance;`}
    >
      {copy.headlineLead}<span style={gradientStyle}>{copy.headlineGradient}</span>{copy.headlineTail}
    </h1>
    <p
      class="tm-load mt-6 text-lede font-light text-body"
      style="--d: 180ms; max-width: 54ch;"
    >
      {copy.lede}
    </p>
    <div class="tm-load mt-8 flex flex-wrap items-center gap-4" style="--d: 270ms;">
      <Button href={`/${lang}/contact`} style="min-height: 46px; padding-inline: 24px;">
        {t("cta.primary")}
      </Button>
    </div>
  </div>
</Section>
