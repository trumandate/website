---
// InitiativeRows.astro — /execution's ONE fragment (Execution
// (redesign).dc.html §2, "Initiative fragment"). Redesign wave B replaces
// the pre-redesign inline-SVG table wholesale with the reference's own
// real-DOM stacked record cards: a status dot, name, funding objective, slip
// figure (mint on-time, gold minor slip, coral off-track) and a gradient
// progress bar per row — "not a flat table," the README's own phrase — the
// whole list cropped by a bottom `mask-image` fade rather than a hand-cut
// SVG viewBox. The fourth (red) row carries a tinted background, a coral
// border-inline-start marker and a pulsing status dot (`.tm-live`,
// global.css) — the one "critical, needs no separate exception report" row
// the page's caption and argument both refer to.
//
// WITHHELD, and absent from this file by design: the gate workflow and the
// approval routing — no reader of this fragment, in either language, can
// tell how a stage-gate decision gets routed or to whom. `/execution`'s
// handoff sentence is the only place either is named.
//
// RTL: `grid-template-columns` gets the reference's own narrower first-three-
// column widths (its own authored AR values, not a mechanical translation of
// the EN ones); everything else mirrors automatically via logical
// properties (`border-inline-start`, `inset-inline-start`) and the row's own
// unmirrored `flex`/`grid` inline axis.
//
// Colours resolve from tailwind.config.mjs at build time for the two rgba
// washes with no existing token (the coral-tinted critical row's border and
// background) — same `hexToRgb` pattern as `KpiCard.astro`/`AiMomentCard.astro`.
//
// 2026-09-02 (owner decision, logged in BUILD_FLAGS.md): the reference's
// `max-width: 880px` on this wrapper is deliberately NOT reproduced — the
// full reasoning and the measurements are in KpiCard.astro's note. This
// fragment's cut is the bottom mask, not an inline-end one, so nothing else
// here changes: the panel simply spans the section's own content box (1036px
// from ~1324px up, ending on the same x the header CTA ends on) instead of
// stopping 156px short of it, and the row grid's `minmax()` tracks absorb the
// extra width. Type sizes, row count and the 340px crop height are untouched.
//
import type { Language } from "../../i18n/types";
import tailwindConfig from "../../../tailwind.config.mjs";

interface Props {
  class?: string;
  lang: Language;
  caption: string;
}

const { class: className, lang, caption }: Props = Astro.props;
const isAr = lang === "ar";

const colors = (tailwindConfig as { theme: { colors: Record<string, string> } })
  .theme.colors;

function hexToRgb(hex: string): string {
  const clean = hex.replace("#", "");
  return [0, 2, 4]
    .map((i) => Number.parseInt(clean.slice(i, i + 2), 16))
    .join(",");
}

const coralDarkRgb = hexToRgb(colors["coral-dark"]);
const redRgb = hexToRgb(colors.red);

const gridCols = isAr
  ? "minmax(180px, 1.5fr) minmax(100px, 0.9fr) minmax(70px, 0.6fr) minmax(140px, 1fr)"
  : "minmax(200px, 1.5fr) minmax(110px, 0.9fr) minmax(90px, 0.7fr) minmax(140px, 1fr)";

const dUnit = isAr ? "د" : "d";

// AR reference reaches for the real `text-datum` role (no inline
// font-size) on these row micro-labels, letting the sitewide
// `[dir=rtl] .text-datum → text-datum-ar` override (global.css) size
// Arabic ~10% larger than the EN reference's own bespoke 9/11px literal
// values — the same two-branch pattern KpiCard.astro documents at length.
const microClass = (extra: string) =>
  (isAr ? `font-mono text-datum font-data ${extra}` : `font-mono font-data ${extra}`).trim();
const microSize = (px: number) => (isAr ? undefined : `font-size: ${px}px;`);

const rows = [
  {
    name: isAr ? "بوابة الخدمات الموحّدة" : "Unified service portal",
    objective: isAr ? "الهدف 1.2" : "Objective 1.2",
    dotClass: "bg-mint",
    slip: `0 ${dUnit}`,
    slipClass: "text-mint",
    pct: 74,
    barClass: isAr ? "bg-grad-mint-rtl" : "bg-grad-mint",
    animate: true,
    delay: undefined as string | undefined,
    critical: false,
  },
  {
    name: isAr ? "رقمنة السجلات" : "Records digitisation",
    objective: isAr ? "الهدف 1.2" : "Objective 1.2",
    dotClass: "bg-gold",
    slip: `+6 ${dUnit}`,
    slipClass: "text-gold",
    pct: 41,
    barClass: isAr ? "bg-grad-gold-rtl" : "bg-grad-gold",
    animate: true,
    delay: "200ms",
    critical: false,
  },
  {
    name: isAr ? "إيقاف الأنظمة القديمة" : "Legacy decommission",
    objective: isAr ? "الهدف 3.1" : "Objective 3.1",
    dotClass: "bg-coral-dark",
    slip: `+34 ${dUnit}`,
    slipClass: "text-coral",
    pct: 18,
    barClass: "bg-coral-dark",
    animate: true,
    delay: "300ms",
    critical: true,
  },
  {
    name: isAr ? "إطلاق الهوية المشتركة" : "Shared identity rollout",
    objective: isAr ? "الهدف 2.4" : "Objective 2.4",
    dotClass: "bg-mint",
    slip: `0 ${dUnit}`,
    slipClass: "text-mint",
    pct: 66,
    barClass: isAr ? "bg-grad-mint-rtl" : "bg-grad-mint",
    animate: false,
    delay: undefined as string | undefined,
    critical: false,
  },
];
---

<div class:list={["tm-boardload", className]} style="--d: 380ms; position: relative;">
  <div
    class="border-hairline bg-surface"
    style="border-width: 1px; border-radius: 6px; box-shadow: inset 0 1px 0 0 rgba(255,255,255,0.16), 0 14px 32px -10px rgba(2,24,19,0.6); overflow: hidden; max-height: 340px;"
  >
    <div
      style={`mask-image: linear-gradient(to bottom, black 0%, black 72%, transparent 99%); -webkit-mask-image: linear-gradient(to bottom, black 0%, black 72%, transparent 99%);`}
    >
      <div class="border-hairline" style="display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 18px; border-bottom-width: 1px;">
        <span class="font-sans font-semi text-paper" style="font-size: 13px;">
          {isAr ? "المحفظة · المبادرات" : "Portfolio · initiatives"}
        </span>
        <span class={microClass("tracking-datum text-muted")} style={microSize(9)}>
          {isAr ? "مجمَّعة حيّاً من خطوط أساس المعالم" : "Rolled up from milestone baselines, live"}
        </span>
      </div>
      <div style="display: flex; flex-direction: column; gap: 8px; padding: 12px;">
        {
          rows.map((row) =>
            row.critical ? (
              <div
                style={`display: grid; grid-template-columns: ${gridCols}; gap: 12px; padding: 12px 14px; border: 1px solid rgba(${coralDarkRgb},0.3); border-inline-start: 2px solid ${colors["coral-dark"]}; border-radius: 4px; background: rgba(${redRgb},0.07); align-items: center;`}
              >
                <span style="display: inline-flex; align-items: center; gap: 8px;">
                  <span aria-hidden="true" class="tm-live bg-coral-dark" style="width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;" />
                  <span class="font-sans font-semi text-paper" style="font-size: 13px;">{row.name}</span>
                </span>
                <span dir="ltr" class={microClass("text-muted")} style={microSize(11)}>{row.objective}</span>
                <span dir="ltr" class={microClass(row.slipClass)} style={microSize(11)}>{row.slip}</span>
                <span style="display: flex; align-items: center; gap: 8px;">
                  <span class="bg-hairline-08" style="position: relative; height: 4px; border-radius: 2px; flex: 1;">
                    <span class:list={[row.barClass]} style={`position: absolute; inset-block: 0; inset-inline-start: 0; width: ${row.pct}%; border-radius: 2px; display: block;`} />
                  </span>
                  <span dir="ltr" class={microClass("text-paper")} style={microSize(11)}>{row.pct}%</span>
                </span>
              </div>
            ) : (
              <div
                class="border-hairline-08 bg-ai-panel-deep"
                style={`display: grid; grid-template-columns: ${gridCols}; gap: 12px; padding: 12px 14px; border-width: 1px; border-radius: 4px; box-shadow: inset 0 1px 0 0 ${colors.hairline}; align-items: center;`}
              >
                <span style="display: inline-flex; align-items: center; gap: 8px;">
                  <span aria-hidden="true" class:list={[row.dotClass]} style="width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;" />
                  <span class="font-sans font-semi text-paper" style="font-size: 13px;">{row.name}</span>
                </span>
                <span dir="ltr" class={microClass("text-muted")} style={microSize(11)}>{row.objective}</span>
                <span dir="ltr" class={microClass(row.slipClass)} style={microSize(11)}>{row.slip}</span>
                <span style="display: flex; align-items: center; gap: 8px;">
                  <span class="bg-hairline-08" style="position: relative; height: 4px; border-radius: 2px; flex: 1;">
                    <span
                      class:list={[row.animate && "tm-grow", row.barClass]}
                      style={`${row.delay ? `--d: ${row.delay}; ` : ""}position: absolute; inset-block: 0; inset-inline-start: 0; width: ${row.pct}%; border-radius: 2px; display: block;`}
                    />
                  </span>
                  <span dir="ltr" class={microClass("text-paper")} style={microSize(11)}>{row.pct}%</span>
                </span>
              </div>
            ),
          )
        }
      </div>
    </div>
  </div>
  <p class="tm-load font-mono text-datum font-data tracking-datum text-muted" style="--d: 650ms; margin-top: 14px;">
    {caption}
  </p>
</div>
