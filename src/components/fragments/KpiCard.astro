---
// KpiCard.astro — /strategy's ONE fragment (curiosity ledger: "Reveals: one
// KPI card, fully readable"). Hand-authored inline SVG from tokens, one screen
// region, data anonymised — never the interface (spec §5's fidelity rule).
//
// Contents are exactly the six things the ledger enumerates and nothing more:
// label, baseline, target, live actual, RAG dot, and a sparkline of the last
// six periods. The owner row that the page's argument mentions a KPI carrying
// is deliberately NOT drawn — the ledger's list is a specification, and a card
// that grows an extra row per paragraph of copy is how a fragment becomes a
// screenshot.
//
// WITHHELD, and absent from this file by design: the cascade editor and how
// weighting works. No weight column, no parent-objective tree, no editor
// chrome, and nothing about either in the aria-label, in either language.
// `/strategy`'s handoff sentence is the only place on that page where they are
// named.
//
// The crop is authored into the viewBox: the neighbouring KPI card starts at
// x=320 and runs to x=620, past the viewBox's own 460 edge, so the browser's
// default SVG clipping cuts it roughly in half — the ledger's "cropped so the
// neighbouring card is half visible at the frame edge", with no CSS overflow
// trick and no second mask. Its title text is cut mid-glyph for the same
// reason, which is what a real crop looks like.
//
// Type is sized in bare user-space numbers, not rem — see StageGateQueue.astro
// for the full reasoning (rem resolves against the document root and ignores
// the viewBox transform, decoupling the type from the shapes as the fragment
// scales).
//
// RTL (P6-AR): this fragment carries <text>, so it gets a hand-mirrored
// geometry rather than a CSS scaleX, which would render every glyph backwards.
// Every x becomes `460 - x`; rects additionally subtract their own width,
// since a rect's x is a left edge rather than a point. Two consequences worth
// stating, because both are the point of doing it by hand: the fully readable
// card moves to the fragment's right-hand (RTL inline-start) edge, and the
// neighbouring card moves to x=-160, so the crop lands on the left — the RTL
// inline-END edge — and still reads as "the list continues". fragment.ts
// flips the wipe's travel to match, so the reveal still uncovers from
// inline-start.
//
// Direction handling differs deliberately from StageGateQueue.astro's P5
// treatment. That file pins `direction: ltr` in BOTH languages and flips
// `text-anchor` by hand, which is correct for its labels but forces every
// mixed Arabic-plus-digits string into an LTR paragraph, where the Arabic run
// is laid out to the left of the digits and an Arabic reader meets the number
// first. This fragment instead pins `direction: ltr` for LTR pages only and
// switches the mirrored variant to `direction: rtl`, so `text-anchor: start`
// keeps meaning "the inline-start edge" and resolves to the right by itself —
// the hand-computed coordinates stay honest AND strings like "آخر 6 فترات"
// get their natural Arabic bidi order. known-issues.md's P5 note (direction
// inherits into <text> and redefines what start/end mean) is the reason both
// files state a direction explicitly rather than inheriting one.
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/types";

interface Props {
  class?: string;
  lang: Language;
}

const { class: className, lang }: Props = Astro.props;
const t = useTranslations(lang);
const isAr = lang === "ar";

// Arabic sans at a matched pixel size reads smaller than tracked Latin mono,
// so each role is set ~10% larger in Arabic — the same adjustment
// StageGateQueue.astro makes, for the same reason.
const label = isAr ? "label-ar" : "label";
const name = isAr ? "name-ar" : "name";
const figure = isAr ? "figure-ar" : "figure";
---

<svg
  viewBox="0 0 460 236"
  class:list={["kpi-card w-full max-w-[560px]", className]}
  role="img"
  aria-label={t("fragment.kpiCard.ariaLabel")}
  data-fragment
>
  <defs>
    <mask
      id="kpi-card-wipe-mask"
      maskUnits="userSpaceOnUse"
      x="0"
      y="0"
      width="460"
      height="236"
    >
      <rect x="0" y="0" width="460" height="236" fill="black"></rect>
      <rect data-fragment-wipe x="0" y="0" width="460" height="236" fill="white"
      ></rect>
    </mask>
  </defs>

  <g mask="url(#kpi-card-wipe-mask)">
    <rect width="460" height="236" class="fill-surface-deep"></rect>

    {
      isAr ? (
        <>
          {/* The KPI card itself, mirrored: 460-(8+300)=152. */}
          <rect
            x="152"
            y="10"
            width="300"
            height="216"
            rx="4"
            class="fill-surface stroke-hairline"
            stroke-width="1"
          />

          <text x="434" y="32" class={`${label} fill-muted`}>
            {t("fragment.kpiCard.ref")}
          </text>
          {/* mirrored cx: 460-282=178 */}
          <circle cx="178" cy="28" r="4.5" class="fill-amber" />

          <text x="434" y="57" class={`${name} fill-paper`}>
            {t("fragment.kpiCard.name")}
          </text>

          <line
            x1="434"
            y1="74"
            x2="170"
            y2="74"
            class="stroke-hairline"
            stroke-width="1"
          />

          {/* The three figure columns mirror to right-anchored columns that
              grow leftward: 460-26=434, 460-114=346, 460-202=258. */}
          <text x="434" y="97" class={`${label} fill-muted`}>
            {t("fragment.kpiCard.baselineLabel")}
          </text>
          <text x="434" y="124" class={`${figure} fill-paper`}>
            {t("fragment.kpiCard.baselineValue")}
          </text>

          <text x="346" y="97" class={`${label} fill-muted`}>
            {t("fragment.kpiCard.targetLabel")}
          </text>
          <text x="346" y="124" class={`${figure} fill-paper`}>
            {t("fragment.kpiCard.targetValue")}
          </text>

          <text x="258" y="97" class={`${label} fill-muted`}>
            {t("fragment.kpiCard.actualLabel")}
          </text>
          <text x="258" y="124" class={`${figure} fill-accent`}>
            {t("fragment.kpiCard.actualValue")}
          </text>

          <line
            x1="434"
            y1="142"
            x2="170"
            y2="142"
            class="stroke-hairline"
            stroke-width="1"
          />

          <text x="434" y="163" class={`${label} fill-muted`}>
            {t("fragment.kpiCard.sparklineLabel")}
          </text>

          {/* Sparkline mirrored point by point, so the six periods still run
              from the oldest at inline-start (right) to the newest at
              inline-end (left) — time reads with the language. */}
          <polyline
            points="434,212 382,204 330,207 278,192 226,184 174,174"
            fill="none"
            stroke-width="1.5"
            stroke-linejoin="round"
            stroke-linecap="round"
            class="stroke-accent"
          />
          <circle cx="174" cy="174" r="3" class="fill-accent" />

          {/* The neighbouring card, mirrored: 460-(320+300)=-160. Runs off the
              viewBox's left edge — inline-end in RTL — and is clipped by it. */}
          <rect
            x="-160"
            y="10"
            width="300"
            height="216"
            rx="4"
            class="fill-surface stroke-hairline"
            stroke-width="1"
          />

          <text x="122" y="32" class={`${label} fill-muted`}>
            {t("fragment.kpiCard.nextRef")}
          </text>
          <text x="122" y="57" class={`${name} fill-paper`}>
            {t("fragment.kpiCard.nextName")}
          </text>
          <line
            x1="122"
            y1="74"
            x2="0"
            y2="74"
            class="stroke-hairline"
            stroke-width="1"
          />
          <text x="122" y="97" class={`${label} fill-muted`}>
            {t("fragment.kpiCard.nextBaselineLabel")}
          </text>
          <text x="122" y="124" class={`${figure} fill-paper`}>
            {t("fragment.kpiCard.nextBaselineValue")}
          </text>
        </>
      ) : (
        <>
          {/* The KPI card itself, fully readable */}
          <rect
            x="8"
            y="10"
            width="300"
            height="216"
            rx="4"
            class="fill-surface stroke-hairline"
            stroke-width="1"
          />

          <text x="26" y="32" class={`${label} fill-muted`}>
            {t("fragment.kpiCard.ref")}
          </text>
          <circle cx="282" cy="28" r="4.5" class="fill-amber" />

          <text x="26" y="57" class={`${name} fill-paper`}>
            {t("fragment.kpiCard.name")}
          </text>

          <line
            x1="26"
            y1="74"
            x2="290"
            y2="74"
            class="stroke-hairline"
            stroke-width="1"
          />

          <text x="26" y="97" class={`${label} fill-muted`}>
            {t("fragment.kpiCard.baselineLabel")}
          </text>
          <text x="26" y="124" class={`${figure} fill-paper`}>
            {t("fragment.kpiCard.baselineValue")}
          </text>

          <text x="114" y="97" class={`${label} fill-muted`}>
            {t("fragment.kpiCard.targetLabel")}
          </text>
          <text x="114" y="124" class={`${figure} fill-paper`}>
            {t("fragment.kpiCard.targetValue")}
          </text>

          <text x="202" y="97" class={`${label} fill-muted`}>
            {t("fragment.kpiCard.actualLabel")}
          </text>
          <text x="202" y="124" class={`${figure} fill-accent`}>
            {t("fragment.kpiCard.actualValue")}
          </text>

          <line
            x1="26"
            y1="142"
            x2="290"
            y2="142"
            class="stroke-hairline"
            stroke-width="1"
          />

          <text x="26" y="163" class={`${label} fill-muted`}>
            {t("fragment.kpiCard.sparklineLabel")}
          </text>

          <polyline
            points="26,212 78,204 130,207 182,192 234,184 286,174"
            fill="none"
            stroke-width="1.5"
            stroke-linejoin="round"
            stroke-linecap="round"
            class="stroke-accent"
          />
          <circle cx="286" cy="174" r="3" class="fill-accent" />

          {/* The neighbouring card: starts in-frame, geometry runs past the
              viewBox's edge and is clipped by it. */}
          <rect
            x="320"
            y="10"
            width="300"
            height="216"
            rx="4"
            class="fill-surface stroke-hairline"
            stroke-width="1"
          />

          <text x="338" y="32" class={`${label} fill-muted`}>
            {t("fragment.kpiCard.nextRef")}
          </text>
          <text x="338" y="57" class={`${name} fill-paper`}>
            {t("fragment.kpiCard.nextName")}
          </text>
          <line
            x1="338"
            y1="74"
            x2="460"
            y2="74"
            class="stroke-hairline"
            stroke-width="1"
          />
          <text x="338" y="97" class={`${label} fill-muted`}>
            {t("fragment.kpiCard.nextBaselineLabel")}
          </text>
          <text x="338" y="124" class={`${figure} fill-paper`}>
            {t("fragment.kpiCard.nextBaselineValue")}
          </text>
        </>
      )
    }
  </g>
</svg>

<script src="../../scripts/fragment.ts"></script>

<style>
  /* Spec §3's three type roles, expressed in the fragment's own user-space
     units. Same treatment as StageGateQueue.astro: addressed as local classes
     rather than through the shared .font-mono/.text-datum utilities, because
     those carry rem sizes that would not scale with the artwork. */
  .label {
    font-family: theme("fontFamily.mono");
    font-weight: theme("fontWeight.data");
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .name {
    font-family: theme("fontFamily.sans");
    font-weight: theme("fontWeight.semi");
    font-size: 14px;
  }

  .figure {
    font-family: theme("fontFamily.mono");
    font-weight: theme("fontWeight.data");
    font-size: 22px;
  }

  /* Arabic: spec §3's mono role swaps to Plex Sans 600 at normal tracking,
     because letterspaced mono destroys Arabic joining. Repeated here rather
     than inherited from global.css's `[dir="rtl"] .font-mono` override,
     because fragment type is sized in user-space units and never goes through
     that utility. The figure role swaps too, even though "42.0" contains no
     Arabic: `/ar` never preloads Plex Mono (BaseLayout.astro), so leaving it
     mono would make three digits the only reason the page fetches a fifth
     font file. */
  .label-ar {
    font-family: theme("fontFamily.sans");
    font-weight: theme("fontWeight.semi");
    font-size: 12px;
    letter-spacing: 0;
    text-transform: none;
  }

  .name-ar {
    font-family: theme("fontFamily.sans");
    font-weight: theme("fontWeight.semi");
    font-size: 15px;
  }

  .figure-ar {
    font-family: theme("fontFamily.sans");
    font-weight: theme("fontWeight.semi");
    font-size: 22px;
  }

  /* known-issues.md (P5): `direction` inherits into <text>, and
     `text-anchor: start`/`end` are defined relative to it, so a fragment that
     inherits its direction from <html> has coordinates whose meaning changes
     under the reader's locale. Both branches above therefore state a direction
     explicitly: LTR pages get `ltr` (matching the unmirrored geometry), and
     the mirrored Arabic geometry gets `rtl`, which is what makes its
     unqualified `text-anchor: start` resolve to the right-hand edge without a
     single hand-flipped anchor — and lets mixed strings such as
     "آخر 6 فترات" order themselves the way an Arabic reader reads them.
     `:global()` wraps the ancestor half of the selector: Astro's scoped-style
     processor otherwise appends this component's scope hash to `[dir="rtl"]`
     too, producing a selector that can never match, since dir lives on
     <html>. That bug is why the P4 confidence-bar override silently did
     nothing until P5 — see SuggestionCard.astro. */
  .kpi-card {
    direction: ltr;
  }

  :global([dir="rtl"]) .kpi-card {
    direction: rtl;
  }
</style>
