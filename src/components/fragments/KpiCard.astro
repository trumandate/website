---
// KpiCard.astro — /strategy's ONE fragment (Strategy (redesign).dc.html §2,
// "KPI fragment"). Redesign wave B replaces the pre-redesign inline-SVG card
// wholesale with the reference's own real-DOM/CSS card: a full KPI record
// (ref, at-risk pill, name, baseline/target/live-actual figures, a gradient
// sparkline, "Carries" chips linking Objective/Initiatives/Benefit) plus a
// second card cropped by an inline-end mask fade — "the neighbouring card is
// half visible at the frame edge," reproduced with `overflow:hidden` +
// `mask-image` on the row wrapper exactly as the reference does it, not a
// hand-computed SVG viewBox crop.
//
// WITHHELD, and absent from this file by design: the cascade editor and how
// weighting works — no weight column, no parent-objective tree, no editor
// chrome, in either language. `/strategy`'s handoff sentence is the only
// place either is named.
//
// RTL: the crop mirrors by flipping the mask's own gradient direction ("to
// left" instead of "to right") — the row's `display:flex` needs no DOM
// reordering, since an un-annotated `flex-direction: row` already lays out
// along the *inline* axis and reverses under `dir="rtl"` by itself (verified
// against the reference's own AR markup, which keeps the same card order).
// The sparkline SVG pins `direction: ltr` regardless of language — its path
// coordinates are decorative and unmirrored in the reference's own AR file,
// matching the fragment's `direction: ltr` device other fragments use for
// numeric figures.
//
// 2026-09-02 (owner decision, logged in BUILD_FLAGS.md): the reference's own
// `max-width: 880px` on this wrapper is DELIBERATELY NOT reproduced. At 880px
// the crop landed 156px short of the section's own content edge (measured,
// chrome-devtools: fragment ended at x 1074.3 against a content edge of
// 1230.3 at 1440, and at 1314.3 against 1470.3 at 1920), so the fade read as
// an arbitrary stop mid-figure rather than the "cropped at the section edge"
// CLAUDE.md's fragment invariant asks for. The wrapper now fills the
// `max-w-content` + `px-gutter` content box (1036px from ~1324px up) — the
// same grid, and the same inline-end x, the header's own CTA ends on.
//
// Two knock-on changes keep the composition itself intact rather than just
// letting a wider frame reveal the whole second card:
//   - the row is held 120px wider than its frame (`width: calc(100% + 120px)`),
//     so exactly 120px — 30% of the 400px neighbour card — sits outside the
//     crop at EVERY frame width, instead of a fraction that shrank as the
//     frame grew;
//   - the primary card takes the slack (`flex: 1 0 560px`) instead of the
//     reference's rigid `0 0 560px`, so the extra width lands on the record
//     being read, not on dead space. Nothing is scaled or stretched; the
//     figures, sparkline and chips keep their own type sizes.
// `min-width: 980px` still governs below ~860px of frame, so every viewport
// at or below tablet renders the composition it rendered before.
//
// Type sizes, a two-part fix caught only by measured comparison against the
// reference (chips wrapped to a second line, +43px section height first
// pass; then a second, opposite-direction 29px gap on /ar):
//   EN: this card's micro-labels (9/10px) are the reference's OWN bespoke
//       literal pixel values, NOT the sitewide `text-eyebrow`/`text-datum`
//       roles (11.2/11.52px) — `tracking-eyebrow`/`tracking-datum`
//       (letter-spacing only) pair with an explicit inline `font-size`
//       exactly as the EN reference composes them.
//   AR: the reference's own AR file does the OPPOSITE for these same
//       labels — it reaches for the real `text-datum` role (no inline
//       font-size), letting the sitewide `[dir=rtl] .text-datum →
//       text-datum-ar` override (global.css) size Arabic ~10% larger than
//       the Latin figure, the same "Arabic reads smaller at a matched pixel
//       size" adjustment this fragment's pre-redesign version made by hand.
//       Reproduced here as an `isAr` branch per label rather than one
//       shared class list.
// Only the outer mono caption line uses `text-datum` in both languages,
// matching the reference (it's the one label already sized at the sitewide
// role in EN too).
//
// Colours resolve from tailwind.config.mjs at build time (no hex literal in
// this file) for the two values with no existing utility class: the sparkline
// stroke/area gradients and the card's own two-stop background wash.
import type { Language } from "../../i18n/types";
import tailwindConfig from "../../../tailwind.config.mjs";

interface Props {
  class?: string;
  lang: Language;
  /** The mono caption line under the fragment (ProductPageCopy's own
   * `fragmentCaption`) — rendered here, inside the same `.tm-boardload`
   * wrapper, exactly where the reference places it. */
  caption: string;
}

const { class: className, lang, caption }: Props = Astro.props;
const isAr = lang === "ar";

const colors = (tailwindConfig as { theme: { colors: Record<string, string> } })
  .theme.colors;

function hexToRgb(hex: string): string {
  const clean = hex.replace("#", "");
  return [0, 2, 4]
    .map((i) => Number.parseInt(clean.slice(i, i + 2), 16))
    .join(",");
}

const cyanRgb = hexToRgb(colors.cyan);
const cardBg = `linear-gradient(180deg, ${colors["kpi-tile-top"]} 0%, ${colors.surface} 100%)`;
const cardShadow = `inset 0 1px 0 0 ${colors.highlight}, 0 14px 32px -10px rgba(2,24,19,0.6)`;

// The two micro-label class/style pairs the reference switches between —
// "ref" role keeps `tracking-datum` in both languages (the AR file's own
// choice, harmless redundancy under RTL since `text-datum-ar`'s own
// letter-spacing:0 wins on specificity); "eyebrow" role drops all tracking
// in AR, matching the reference exactly.
const refClass = isAr
  ? "font-mono text-datum font-data tracking-datum text-muted"
  : "font-mono font-data tracking-datum text-muted";
const refStyle = isAr ? undefined : "font-size: 10px; text-transform: uppercase;";

const eyebrowMicroClass = (colorClass: string) =>
  isAr ? `font-mono text-datum font-data ${colorClass}` : `font-mono font-data ${colorClass}`;
const eyebrowMicroStyle = (extra = "") =>
  isAr ? undefined : `font-size: 9px; text-transform: uppercase;${extra}`;

const copy = {
  ref: isAr ? "مؤشر · 1.2.3" : "KPI · 1.2.3",
  atRisk: isAr ? "في خطر" : "At risk",
  name: isAr ? "تبنّي الخدمات الرقمية" : "Digital service adoption",
  baselineLabel: isAr ? "خط الأساس" : "Baseline",
  baselineValue: "42.0",
  targetLabel: isAr ? "المستهدف" : "Target",
  targetValue: "75.0",
  actualLabel: isAr ? "الفعلي الحي" : "Live actual",
  actualValue: "61.4",
  carriesLabel: isAr ? "يحمل" : "Carries",
  chipObjective: isAr ? "الهدف 1.2" : "Objective 1.2",
  chipInitiative07: isAr ? "المبادرة 07" : "Initiative 07",
  chipInitiative12: isAr ? "المبادرة 12" : "Initiative 12",
  chipBenefit: isAr ? "المنفعة 4.2" : "Benefit 4.2",
  nextRef: isAr ? "مؤشر · 1.2.4" : "KPI · 1.2.4",
  nextName: isAr ? "زمن معالجة المعاملة" : "Case processing time",
  nextBaselineValue: "38.0",
  nextTargetValue: "21.0",
};
---

<div class:list={["tm-boardload", className]} style="--d: 380ms; position: relative;">
  <div
    style={`position: relative; overflow: hidden; mask-image: linear-gradient(to ${isAr ? "left" : "right"}, black 0%, black 78%, transparent 99%); -webkit-mask-image: linear-gradient(to ${isAr ? "left" : "right"}, black 0%, black 78%, transparent 99%);`}
  >
    <div style="display: flex; gap: 14px; min-width: 980px; width: calc(100% + 120px);">
      <div
        style={`flex: 1 0 560px; border: 1px solid ${colors.hairline}; border-radius: 6px; background: ${cardBg}; padding: 20px; box-shadow: ${cardShadow};`}
      >
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px;">
          <span class={refClass} style={refStyle}>{copy.ref}</span>
          <span style="display: inline-flex; align-items: center; gap: 5px; padding: 2px 9px; border-radius: 9999px; background: rgba(255,201,92,0.14);">
            <span aria-hidden="true" class="bg-gold" style="width: 5px; height: 5px; border-radius: 50%;"></span>
            <span class={eyebrowMicroClass("text-gold")} style={isAr ? undefined : "font-size: 9px;"}>{copy.atRisk}</span>
          </span>
        </div>
        <p class="font-sans font-semi tracking-heading text-paper" style="font-size: 19px; margin: 8px 0 0;">{copy.name}</p>
        <div class="border-hairline" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; border-top-width: 1px; border-top-style: solid; margin-top: 14px; padding-top: 14px;">
          <div>
            <p class={eyebrowMicroClass("text-muted")} style={eyebrowMicroStyle(" margin: 0;")}>{copy.baselineLabel}</p>
            <p dir="ltr" class="font-mono font-data text-paper" style="font-size: 24px; margin: 6px 0 0;">{copy.baselineValue}</p>
          </div>
          <div>
            <p class={eyebrowMicroClass("text-muted")} style={eyebrowMicroStyle(" margin: 0;")}>{copy.targetLabel}</p>
            <p dir="ltr" class="font-mono font-data text-paper" style="font-size: 24px; margin: 6px 0 0;">{copy.targetValue}</p>
          </div>
          <div>
            <p class={eyebrowMicroClass("text-muted")} style={eyebrowMicroStyle(" margin: 0;")}>{copy.actualLabel}</p>
            <p dir="ltr" class="font-mono font-data text-cyan" style="font-size: 24px; margin: 6px 0 0;">{copy.actualValue}</p>
          </div>
        </div>
        <svg viewBox="0 0 500 54" style="width: 100%; margin-top: 14px; direction: ltr;" aria-hidden="true">
          <defs>
            <linearGradient id="kpi-spark-stroke" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color={colors.accent}></stop>
              <stop offset="1" stop-color={colors.cyan}></stop>
            </linearGradient>
            <linearGradient id="kpi-spark-area" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color={`rgba(${cyanRgb},0.25)`}></stop>
              <stop offset="1" stop-color={`rgba(${cyanRgb},0)`}></stop>
            </linearGradient>
          </defs>
          <path d="M2 44 L85 40 L168 42 L251 30 L334 24 L417 18 L498 10 L498 54 L2 54 Z" fill="url(#kpi-spark-area)"></path>
          <path class="tm-spark" d="M2 44 L85 40 L168 42 L251 30 L334 24 L417 18 L498 10" fill="none" stroke="url(#kpi-spark-stroke)" stroke-width="2" stroke-linecap="round"></path>
          <circle cx="498" cy="10" r="3.5" class="fill-cyan"></circle>
        </svg>
        <div class="border-hairline" style="display: flex; flex-wrap: wrap; gap: 8px; border-top-width: 1px; border-top-style: solid; margin-top: 14px; padding-top: 12px;">
          <span class={eyebrowMicroClass("text-muted")} style={isAr ? "align-self: center;" : "font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em; align-self: center;"}>{copy.carriesLabel}</span>
          <span style="padding: 4px 10px; border-radius: 9999px; border: 1px solid rgba(89,216,230,0.35);">
            <span class={eyebrowMicroClass("text-cyan")} style={isAr ? undefined : "font-size: 9px;"}>{copy.chipObjective}</span>
          </span>
          <span style="padding: 4px 10px; border-radius: 9999px; border: 1px solid rgba(255,255,255,0.14);">
            <span class={eyebrowMicroClass("text-paper")} style={isAr ? undefined : "font-size: 9px;"}>{copy.chipInitiative07}</span>
          </span>
          <span style="padding: 4px 10px; border-radius: 9999px; border: 1px solid rgba(255,255,255,0.14);">
            <span class={eyebrowMicroClass("text-paper")} style={isAr ? undefined : "font-size: 9px;"}>{copy.chipInitiative12}</span>
          </span>
          <span style="padding: 4px 10px; border-radius: 9999px; border: 1px solid rgba(255,255,255,0.14);">
            <span class={eyebrowMicroClass("text-paper")} style={isAr ? undefined : "font-size: 9px;"}>{copy.chipBenefit}</span>
          </span>
        </div>
      </div>

      <div
        class="border-hairline bg-surface"
        style={`flex: 0 0 400px; border-width: 1px; border-radius: 6px; padding: 20px; box-shadow: inset 0 1px 0 0 ${colors.highlight};`}
      >
        <span class={refClass} style={refStyle}>{copy.nextRef}</span>
        <p class="font-sans font-semi tracking-heading text-paper" style="font-size: 19px; margin: 8px 0 0;">{copy.nextName}</p>
        <div class="border-hairline" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; border-top-width: 1px; border-top-style: solid; margin-top: 14px; padding-top: 14px;">
          <div>
            <p class={eyebrowMicroClass("text-muted")} style={eyebrowMicroStyle(" margin: 0;")}>{copy.baselineLabel}</p>
            <p dir="ltr" class="font-mono font-data text-paper" style="font-size: 24px; margin: 6px 0 0;">{copy.nextBaselineValue}</p>
          </div>
          <div>
            <p class={eyebrowMicroClass("text-muted")} style={eyebrowMicroStyle(" margin: 0;")}>{copy.targetLabel}</p>
            <p dir="ltr" class="font-mono font-data text-paper" style="font-size: 24px; margin: 6px 0 0;">{copy.nextTargetValue}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <p class="tm-load font-mono text-datum font-data tracking-datum text-muted" style="--d: 650ms; margin-top: 14px;">
    {caption}
  </p>
</div>
