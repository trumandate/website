---
// BenefitCurve.astro — /benefits's ONE fragment (Benefits (redesign).dc.html
// §2, "Benefit curve fragment"). Redesign wave B replaces the pre-redesign
// SVG chart wholesale with the reference's own version: a gold-tinted
// "measurement window" band (24 months from closure), a dashed forecast line
// running the chart's full width, a gradient actual line solid only to
// today (with an endpoint dot + halo), a "−18% VS FORECAST / AI FLAG"
// callout box, and a "Today" marker — cropped by an inline-end mask fade.
//
// WITHHELD, and absent from this file by design: the benefit register and
// the attribution logic — no reader of this fragment, in either language,
// can tell how a benefit is apportioned to the work that produced it.
// `/benefits`'s handoff sentence is the only place either is named.
//
// role="img" + aria-label (unlike the two DOM fragments this wave adds):
// this one really is a chart image, not real text a screen reader can
// linearize on its own — the label states the same fact the visual callout
// does (actual 18% below forecast, found in the quarter after closure)
// rather than every coordinate.
//
// RTL (known-issues.md's established pattern): `direction: ltr` is pinned
// explicitly on the `<svg>` in BOTH languages, since `text-anchor`
// inherits `direction` and the reference's own path/text coordinates are
// authored once and never hand-mirrored — only the outer mask's crop
// direction and the callout box's own (wider, Arabic-authored) width flip.
//
// Colours resolve from tailwind.config.mjs at build time for the rgba washes
// with no existing token (the gold measurement-window tint, the mint
// endpoint halo) — same `hexToRgb` pattern as the other two new fragments.
//
// 2026-09-02 (owner decision, logged in BUILD_FLAGS.md): the reference's
// `max-width: 880px` on this wrapper is deliberately NOT reproduced — the
// full reasoning and the measurements are in KpiCard.astro's note. Nothing
// inside this file changes: the chart is one `viewBox` scaled by
// `width: 100%`, so a wider frame scales the whole composition uniformly (no
// stretch, no re-authored coordinates, and the labels get LARGER, not
// smaller), and the inline-end mask — being a percentage of that same frame —
// keeps its cut on the same chart coordinate it had at 880px. It now simply
// lands on the section's content edge rather than 156px inside it.
//
import type { Language } from "../../i18n/types";
import tailwindConfig from "../../../tailwind.config.mjs";

interface Props {
  class?: string;
  lang: Language;
  caption: string;
}

const { class: className, lang, caption }: Props = Astro.props;
const isAr = lang === "ar";

const colors = (tailwindConfig as { theme: { colors: Record<string, string> } })
  .theme.colors;

function hexToRgb(hex: string): string {
  const clean = hex.replace("#", "");
  return [0, 2, 4]
    .map((i) => Number.parseInt(clean.slice(i, i + 2), 16))
    .join(",");
}

const goldRgb = hexToRgb(colors.gold);
const mintRgb = hexToRgb(colors.mint);
const accentRgb = hexToRgb(colors.accent);

const ariaLabel = isAr
  ? "منحنى منفعة واحد: القيمة الفعلية مقابل المتوقَّعة. القيمة الفعلية انحرفت 18 بالمئة دون المتوقَّع في الربع الذي تلا إغلاق المشروع، وهو ما وسمه الذكاء الاصطناعي."
  : "One benefit curve: actual against forecast. Actual has diverged 18 per cent below forecast in the quarter after project closure, flagged by AI.";

// Arabic text inside the SVG uses Plex Sans Arabic 600 rather than mono —
// `/ar` never preloads Plex Mono (BaseLayout.astro), matching the other two
// fragments' own digit/label treatment.
const svgFontFamily = isAr
  ? "'IBM Plex Sans Arabic', sans-serif"
  : "'IBM Plex Mono', monospace";
const svgFontWeight = isAr ? 600 : 400;

// Same two-branch micro-label pattern as KpiCard.astro/InitiativeRows.astro:
// the AR reference reaches for the real `text-datum` role (no inline
// font-size, no `uppercase`/tracking beyond what the role already bundles)
// on these two plain-HTML header spans, letting the sitewide
// `[dir=rtl] .text-datum → text-datum-ar` override size Arabic ~10% larger
// than the EN reference's own bespoke 9/10px literal values.
const microClass = (extra: string) =>
  (isAr ? `font-mono text-datum font-data ${extra}` : `font-mono font-data ${extra}`).trim();
---

<div class:list={["tm-boardload", className]} style="--d: 380ms; position: relative;">
  <div
    style={`border: 1px solid ${colors.hairline}; border-radius: 6px; background: linear-gradient(180deg, ${colors["kpi-tile-top"]} 0%, ${colors.surface} 100%); padding: 20px; box-shadow: inset 0 1px 0 0 ${colors.highlight}, 0 14px 32px -10px rgba(2,24,19,0.6); overflow: hidden; mask-image: linear-gradient(to ${isAr ? "left" : "right"}, black 0%, black 82%, transparent 99%); -webkit-mask-image: linear-gradient(to ${isAr ? "left" : "right"}, black 0%, black 82%, transparent 99%);`}
  >
    <div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 10px;">
      <span class={microClass("tracking-datum text-muted")} style={isAr ? undefined : "font-size: 10px; text-transform: uppercase;"}>
        {isAr ? "المنفعة 4.2 · وفر تشغيلي سنوي" : "Benefit 4.2 · Annual operating saving"}
      </span>
      <span style="display: inline-flex; gap: 14px;">
        <span class={microClass("text-muted")} style={isAr ? undefined : "font-size: 9px;"}>
          <span class="text-mint">—</span> {isAr ? "الفعلي" : "Actual"}
        </span>
        <span class={microClass("text-muted")} style={isAr ? undefined : "font-size: 9px;"}>‑ ‑ {isAr ? "المتوقَّع" : "Forecast"}</span>
      </span>
    </div>
    <svg
      viewBox="0 0 800 250"
      style={`width: 100%; margin-top: 12px; direction: ltr;`}
      role="img"
      aria-label={ariaLabel}
    >
      <defs>
        <linearGradient id="benefit-area" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color={`rgba(${accentRgb},0.28)`}></stop>
          <stop offset="1" stop-color={`rgba(${accentRgb},0)`}></stop>
        </linearGradient>
        <linearGradient id="benefit-stroke" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color={colors.accent}></stop>
          <stop offset="1" stop-color={colors.mint}></stop>
        </linearGradient>
      </defs>

      <rect x="380" y="16" width="420" height="184" fill={`rgba(${goldRgb},0.06)`}></rect>
      <line x1="380" y1="16" x2="380" y2="200" stroke={`rgba(${goldRgb},0.45)`} stroke-width="1"></line>
      <text
        x="390"
        y="32"
        style={`font-family: ${svgFontFamily}; font-weight: ${svgFontWeight}; font-size: ${isAr ? 11 : 10}px; letter-spacing: ${isAr ? "normal" : "0.08em"};`}
        class="fill-gold"
      >
        {isAr ? "نافذة القياس · 24 شهراً من الإغلاق" : "MEASUREMENT WINDOW · 24 MONTHS FROM CLOSURE"}
      </text>

      <line x1="560" y1="52" x2="560" y2="200" stroke="rgba(156,184,174,0.6)" stroke-width="1" stroke-dasharray="3 3"></line>
      <text
        x="560"
        y="222"
        text-anchor="middle"
        style={`font-family: ${svgFontFamily}; font-weight: ${svgFontWeight}; font-size: ${isAr ? 11 : 10}px; letter-spacing: ${isAr ? "normal" : "0.08em"};`}
        class="fill-muted"
      >
        {isAr ? "اليوم" : "TODAY"}
      </text>

      <line x1="10" y1="200" x2="790" y2="200" class="stroke-hairline-08"></line>

      <path
        d="M10 186 C120 178 240 160 380 138 C460 126 540 112 620 96 C680 84 740 72 800 60"
        fill="none"
        stroke="rgba(156,184,174,0.55)"
        stroke-width="1.5"
        stroke-dasharray="5 5"
      ></path>
      <path d="M10 186 C120 178 240 160 380 138 C440 130 500 128 560 132 L560 200 L10 200 Z" fill="url(#benefit-area)"></path>
      <path
        class="tm-spark"
        d="M10 186 C120 178 240 160 380 138 C440 130 500 128 560 132"
        fill="none"
        stroke="url(#benefit-stroke)"
        stroke-width="2.5"
        stroke-linecap="round"
      ></path>
      <circle cx="560" cy="132" r="4" class="fill-mint"></circle>
      <circle cx="560" cy="132" r="9" fill={`rgba(${mintRgb},0.2)`}></circle>

      <rect
        x="574"
        y="96"
        width={isAr ? 168 : 150}
        height="34"
        rx="3"
        class="fill-surface-deep"
        stroke="rgba(255,122,110,0.35)"
      ></rect>
      <text
        x="584"
        y="110"
        style={`font-family: ${svgFontFamily}; font-weight: ${svgFontWeight}; font-size: 11px; letter-spacing: ${isAr ? "normal" : "0.06em"};`}
        class="fill-coral"
      >
        {isAr ? "−18% عن المتوقَّع" : "−18% VS FORECAST"}
      </text>
      <text
        x="584"
        y={isAr ? 124 : 123}
        style={`font-family: ${svgFontFamily}; font-weight: ${svgFontWeight}; font-size: ${isAr ? 10 : 9}px; letter-spacing: ${isAr ? "normal" : "0.06em"};`}
        class="fill-muted"
      >
        {isAr ? "علامة ذكاء · الربع الثاني بعد الإغلاق" : "AI FLAG · Q2 AFTER CLOSURE"}
      </text>
    </svg>
  </div>
  <p class="tm-load font-mono text-datum font-data tracking-datum text-muted" style="--d: 650ms; margin-top: 14px;">
    {caption}
  </p>
</div>
