---
// ContactForm.astro — content brief §7's fields, in the order it lists them,
// plus the honeypot and the two ARIA status regions scripts/contactForm.ts
// drives. Shared by both /en/contact and /ar/contact (BUILD_FLAGS' "keep one
// shared component" bias) — only `lang` differs between the two call sites.
//
// ---- 2026-09-01 contact-form redesign (USER DIRECTIVE: "I also don't like
// the form which we created, make it modern and use good design and color,
// not everything needs to be too dark themed"). ----
//
// The form now sits on the site's ONE light surface (ContactPage.astro's
// paper card). Three things changed and one thing deliberately did not:
//
//   1. Fields became real containers rather than underlines — see
//      FormField.astro's own note for the contrast and touch-target working.
//   2. The interest radios became selectable cards. A naked radio circle is
//      a ~16px target with a label beside it; a card is a 52px-tall target
//      the whole width of its column, which is both the WCAG target-size
//      answer and the reason the chosen option is now legible at a glance
//      (tinted ground + filled mark + accent border, three cues, none of
//      them colour alone).
//   3. The submit button is written here rather than composed from
//      Button.astro. Button's `primary` variant hovers by INVERTING —
//      `bg-accent` becomes transparent with `text-accent` — and `accent`
//      (#19C39B) measures 2.13:1 on this card, so that hover state is
//      unreadable on a light ground. Overriding it with a `class` prop would
//      put two `hover:bg-*` utilities of equal specificity in the sheet and
//      let Tailwind's internal ordering, not source order, decide the winner.
//      A light-surface button is a case the shared dark component does not
//      cover, so it is spelled out once, here, with Button's own motion
//      tokens (micro tier, motion-safe seat) carried over verbatim.
//
// What did NOT change is the submission plumbing. `action` is still the
// entire submission path for a reader with JavaScript disabled, reading the
// endpoint from `PUBLIC_FORMSPREE_ENDPOINT` and falling back to the live
// endpoint so a build without the env var (e.g. Cloudflare CI) still posts
// somewhere real — the endpoint is public by design, it ships in this very
// attribute. Field `name`s, `id`s, the honeypot and both status regions are
// byte-identical to what scripts/contactForm.ts queries for.
//
// Interest values (`full-walkthrough`, `strategy-kpi-cascade`,
// `benefits-realisation`, `deployment-sovereignty`) are stable English keys
// independent of `lang`, so the same Formspree submission is legible
// regardless of which language the visitor filled the form in — an
// implementation judgement call, not brief content (BUILD_FLAGS-style
// decision, logged there).
import FormField from "./FormField.astro";
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/types";

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);

const interestOptions = [
  { value: "full-walkthrough", label: t("contact.interestOption1") },
  { value: "strategy-kpi-cascade", label: t("contact.interestOption2") },
  { value: "benefits-realisation", label: t("contact.interestOption3") },
  { value: "deployment-sovereignty", label: t("contact.interestOption4") },
];
---

{/* No static `novalidate`: scripts/contactForm.ts sets `form.noValidate =
    true` at runtime, once it has actually loaded and can take over
    validation with the custom ARIA pattern below. A JS-disabled reader never
    runs that line, so the browser's own `required`/`type="email"` constraint
    validation (still present on every field regardless of script state)
    stays the enforcement layer for the plain-POST fallback — this is the one
    property "the form should degrade to a normal POST" depends on for
    validated, not just delivered, submissions. */}
<form
  id="contact-form"
  data-contact-form
  action={import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ??
    "https://formspree.io/f/meajpeja"}
  method="POST"
>
  {/* The card's own header. New this redesign: the card is a distinct
      surface now, so it names the document it is, and — more usefully — the
      `*` markers finally have a legend. They were `aria-hidden` decoration
      with nothing anywhere explaining them. */}
  <div class="border-b border-form-rule pb-5">
    <h2 class="font-sans text-h3 font-semi text-form-ink">
      {t("contact.formTitle")}
    </h2>
    <p class="mt-1.5 text-small font-light text-form-muted">
      {t("contact.requiredNote")}
    </p>
  </div>

  {/* Assertive, focus-moved status region for BOTH a failed-validation
      summary and the post-submit success/error result. One region, not two:
      each state fully replaces the previous one's content, and `role="alert"`
      re-announces on every content change regardless of what it says.
      `hidden` at rest — its later appearance is a direct, synchronous result
      of the reader's own submit click, which the CLS metric explicitly
      excludes (`hadRecentInput`), so this doesn't cost the budget the way an
      unrelated layout jump would.

      P10 (DESIGN-ELEVATION.md §4.5): a real-DOM card that "appears in direct
      response to the reader's own action". Its show/replace transition
      adopts `ease-exit` via scripts/contactForm.ts's `style.opacity` toggle
      — `motion-safe:` gates it, so under `prefers-reduced-motion: reduce`
      the property never enters the cascade and the region simply appears.

      2026-09-01: retinted for the light card (`bg-form-field` at rest,
      `form-tint`/`form-alert` per state) and moved to the `field` radius so
      it is the same control shape as everything under it. The class list
      here is also the JS-side default: scripts/contactForm.ts's
      `showStatus()` REPLACES this attribute wholesale on every call, so
      these classes are repeated there too — change one, change both.

      `focus-visible:outline-accent-deep` overrides global.css's site-wide
      `:focus-visible` ring, which is `accent` (#19C39B). That ring is tuned
      for the dark ground and measures 2.0:1 against this region's light
      grounds — under 1.4.11's 3:1 floor for a focus indicator. The utility
      wins because global.css's rule lives in `@layer base`; only the colour
      is replaced, so the 2px width and 2px offset still come from there.
      Every other focusable thing on this card (the inputs, the choice
      tiles, the submit button, and the summary's own jump links) sets its
      own outline colour for the same reason. */}
  <div
    id="form-status"
    data-form-status
    role="alert"
    tabindex="-1"
    hidden
    class="mt-8 rounded-field border border-form-rule border-s-marker border-s-form-line bg-form-field p-5 shadow-field focus-visible:outline-accent-deep motion-safe:transition-opacity motion-safe:duration-state motion-safe:ease-exit"
  >
  </div>

  <div class="mt-8 grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2">
    <FormField
      id="contact-name"
      name="name"
      label={t("contact.nameLabel")}
      required
      autocomplete="name"
    />
    <FormField
      id="contact-organisation"
      name="organisation"
      label={t("contact.orgLabel")}
      required
      autocomplete="organization"
    />
    <FormField
      id="contact-email"
      name="email"
      type="email"
      full
      label={t("contact.emailLabel")}
      required
      autocomplete="email"
    />
  </div>

  {/* The radio group is one "field" for the aria-describedby/aria-invalid
      pattern above — scripts/contactForm.ts toggles this fieldset's
      aria-invalid, not each radio's. Each radio still gets its own static
      aria-invalid="false" below, purely to suppress Chrome's own inference
      (an unauthored, required, unchecked radio is exposed as invalid="true"
      in the accessibility tree from the moment the page loads, driven by
      native constraint validity rather than anything this page's script
      does) — the same premature-before-any-attempt state FormField.astro's
      text/email inputs already avoid with their own static aria-invalid.

      2026-09-01 — how the card works, since it is not the obvious markup:
      the `<input>` IS the card. It is `appearance-none`, absolutely
      positioned to fill the label, and carries the border/ground/radius; the
      mark and the text sit above it at `z-10` with `pointer-events-none` so
      every click and tap lands on the input itself. That keeps a real,
      focusable, arrow-key-navigable native radio group — no `sr-only` input,
      no `role="radio"` re-implementation — while letting `checked:` style the
      whole tile. The mark is one element using the `radio-dot` inset-ring
      shadow rather than a nested dot, because `peer-checked:` compiles to a
      `~` sibling combinator and cannot reach a sibling's descendants. */}
  <fieldset
    id="interest-group"
    class="mt-8 border-0 p-0"
    data-field
    aria-describedby="interest-error"
    aria-invalid="false"
  >
    <legend class="text-small font-semi text-form-ink">
      {t("contact.interestLegend")}
      <span aria-hidden="true" class="text-accent-deep"> *</span>
    </legend>

    {/* One column at every width, not a 2×2. The card is a grid column now
        (ContactPage.astro's two-column composition), which measures ~550px at
        1440 — a 2×2 there gives each tile ~223px, where the longest option
        ("Deployment and data sovereignty" / "النشر وسيادة البيانات") wraps and
        the four tiles stop scanning as one list. A single column also matches
        the general radio-group rule that vertical alignment wins once labels
        are long or the options number more than two. */}
    <div class="mt-3 grid grid-cols-1 gap-3">
      {
        interestOptions.map((option) => (
          <label class="relative flex min-h-[3.25rem] items-center gap-3 rounded-field p-4">
            <input
              type="radio"
              name="interest"
              value={option.value}
              required
              aria-invalid="false"
              class="tm-choice-input peer absolute inset-0 m-0 size-full cursor-pointer appearance-none rounded-field border border-form-line bg-form-field shadow-field transition duration-micro ease-micro hover:border-form-line-strong checked:border-accent-deep checked:bg-form-tint focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-deep"
            />
            <span
              aria-hidden="true"
              class="pointer-events-none relative z-10 block size-5 shrink-0 rounded-full border border-form-line bg-form-field transition duration-micro ease-micro peer-checked:border-accent-deep peer-checked:bg-accent-deep peer-checked:shadow-radio-dot"
            />
            <span class="pointer-events-none relative z-10 text-small font-light text-form-ink">
              {option.label}
            </span>
          </label>
        ))
      }
    </div>

    <p
      id="interest-error"
      data-field-error
      class="mt-2 min-h-[1.3em] text-small font-light text-red-deep"
    >
    </p>
  </fieldset>

  <div class="mt-8">
    <FormField
      id="contact-message"
      name="message"
      type="textarea"
      label={t("contact.messageLabel")}
      optionalLabel={t("contact.optionalLabel")}
    />
  </div>

  {/* Formspree's own honeypot convention: any submission with `_gotcha`
      filled is silently discarded server-side, which is what keeps this
      working with JavaScript disabled too (scripts/contactForm.ts adds a
      matching client-side check only as a belt-and-braces measure). Hidden
      from sight (`visually-hidden`) AND from assistive technology
      (`aria-hidden`) AND from the tab order (`tabindex="-1"`) AND from
      autofill (`autocomplete="off"` plus a name no browser recognises) — a
      sighted keyboard or screen-reader user can never reach or perceive it,
      only a bot that fills every field it can find in the raw HTML. */}
  <div aria-hidden="true" class="visually-hidden">
    <label for="contact-gotcha">{t("contact.honeypotLabel")}</label>
    <input
      id="contact-gotcha"
      type="text"
      name="_gotcha"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <input type="hidden" name="_subject" value="TruMandate — walkthrough request" />

  {/* The footnote moves out of `font-mono text-datum tracking-datum
      text-muted`. That treatment was tuned to read as machine data on a dark
      ground, which is the opposite of what this sentence is doing: it is the
      one humane line on the page, and on paper a tracked-out mono grey reads
      as a system notice rather than a person's promise. Same words, in the
      body face. The `flex-wrap` row keeps the button and the line side by
      side where there is room and stacks them at 375 without a breakpoint. */}
  <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-3">
    <button
      type="submit"
      class="inline-flex min-h-[3rem] shrink-0 items-center justify-center whitespace-nowrap rounded-field bg-accent-deep px-7 text-body font-semi text-form-field transition duration-micro ease-micro hover:bg-accent-deeper focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-form-ink disabled:cursor-progress disabled:bg-form-line-strong motion-safe:hover:-translate-y-px motion-safe:active:translate-y-0"
    >
      <span data-submit-label>{t("cta.primary")}</span>
    </button>
    <p class="text-small font-light text-form-muted">
      {t("contact.footnote")}
    </p>
  </div>
</form>

<style>
  /* The one rule Tailwind cannot express here deterministically. When
     scripts/contactForm.ts marks the GROUP invalid it sets `aria-invalid` on
     the fieldset, not on each radio, so the tiles need a descendant selector
     rather than a variant on the input itself. Written as scoped CSS instead
     of `group-aria-invalid/...` so the compiled selector is visible and
     certain. Astro scopes both ends of it (fieldset and inputs are markup in
     this file), and it is a border colour paired with the red-dotted error
     text below the group — never the only signal.

     The `forced-colors` block restores what `appearance-none` removes: in a
     Windows high-contrast theme a custom-painted radio loses both its native
     glyph and every authored colour, so the chosen tile is re-marked with a
     system-colour outline that forced-colors mode is guaranteed to honour. */
  #interest-group[aria-invalid="true"] .tm-choice-input {
    border-color: theme("colors.red-deep");
  }

  @media (forced-colors: active) {
    .tm-choice-input:checked {
      outline: 3px solid Highlight;
      outline-offset: -3px;
    }
  }
</style>

<script src="../../scripts/contactForm.ts"></script>
