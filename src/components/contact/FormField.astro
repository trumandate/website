---
// FormField.astro — one text/email/textarea field for ContactForm.astro:
// label, native input/textarea, and a permanently-rendered (but empty at
// rest) error paragraph.
//
// Accessibility pattern (P7): `aria-describedby` ties the field to its own
// error paragraph (announced by AT when the field receives focus, or on
// re-focus after a failed submit), `aria-invalid` is toggled by
// scripts/contactForm.ts, and the paragraph keeps a reserved `min-height` at
// ALL times — including empty — so text arriving after validation never
// pushes any field below it (CLAUDE.md: "keep layout stable (no CLS when
// they appear)"). The message text itself renders in `text-paper` (14.96:1
// on ink, verified — see the contrast note in ContactForm.astro), not `red`
// (4.42:1 on ink, i.e. under the 4.5:1 AA floor for normal-size text): the
// small red dot beside it is the colour cue, the paper-coloured text is what
// actually carries the meaning, matching RagDot.astro's own "colour is never
// the only signal" pattern.
//
// Native `required`/`type="email"` stay on the element regardless of
// JavaScript — see ContactForm.astro's comment on `form.noValidate` for why
// this is what keeps a JS-disabled submission validated at all.
//
// P10 (DESIGN-ELEVATION.md §4.5): the border/outline transition moves from
// the content-motion pair (`transition-colors duration-state ease-standard`)
// to the micro tier (`transition duration-micro ease-micro`) — the states
// themselves (the `aria-invalid:border-red` cue, the `:focus-visible` accent
// outline) are unchanged, both information rather than motion, per spec.
interface Props {
  id: string;
  name: string;
  label: string;
  type?: "text" | "email" | "textarea";
  required?: boolean;
  autocomplete?: string;
  /** Span every column of the parent grid, per the reference's own
   *  `grid-column: 1 / -1` on the work-email field. */
  full?: boolean;
}

const {
  id,
  name,
  label,
  type = "text",
  required = false,
  autocomplete,
  full = false,
}: Props = Astro.props;

const errorId = `${id}-error`;
---

<div class:list={["contact-field", full && "col-span-full"]}>
  <label for={id} class="text-small font-semi text-paper">
    {label}
    {required && (
      <span aria-hidden="true" class="text-muted">
        {" "}
        *
      </span>
    )}
  </label>

  {
    type === "textarea" ? (
      <textarea
        id={id}
        name={name}
        rows={4}
        required={required}
        autocomplete={autocomplete}
        aria-describedby={errorId}
        aria-invalid="false"
        class="mt-2 w-full resize-y border-0 border-b border-hairline bg-transparent py-3 text-body font-light text-paper transition duration-micro ease-micro placeholder:text-muted aria-invalid:border-red focus:border-accent"
      />
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        required={required}
        autocomplete={autocomplete}
        aria-describedby={errorId}
        aria-invalid="false"
        class="mt-2 w-full border-0 border-b border-hairline bg-transparent py-3 text-body font-light text-paper transition duration-micro ease-micro placeholder:text-muted aria-invalid:border-red focus:border-accent"
      />
    )
  }

  <p
    id={errorId}
    data-field-error
    class="mt-2 min-h-[1.3em] text-small font-light text-paper"
  ></p>
</div>
