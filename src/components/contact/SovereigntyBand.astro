---
// SovereigntyBand.astro — the "deployment and data sovereignty" band
// trumandate-product-pages.md places once on the home page and once on
// `/contact` (§0: "It is a three-line band... It answers an objection; it
// does not need forty seconds of scroll"). The P0 gate (BUILD_FLAGS.md)
// already resolved the home-page half: dropped there, `/contact` owns it.
//
// What ships here is deliberately TWO lines, not three, and both are
// verbatim:
//   1. content brief §7's own fourth interest option, "Deployment and data
//      sovereignty" / "النشر وسيادة البيانات", reused as the band's frame.
//   2. content brief §6's Fit-section chip, "Sovereign on-premise or cloud"
//      / "استضافة سيادية داخلية أو سحابية", as the one line of substance.
// No verbatim THIRD line exists anywhere in the brief or the product-pages
// doc for this band — the "three-line" description names a shape, not a
// text, and CLAUDE.md's copy rules ban inventing a claim to fill it out.
// Per this build's own instruction ("if no verbatim copy exists for it, add
// a TODO rather than writing marketing copy"), the gap was logged in
// TODO.md instead of papered over with a third sentence Claude Code wrote —
// and at the P9 gate, user-approved 2026-08-17 as the shipped shape: two
// lines, no invented third line. TODO.md's item is closed, not carried
// forward.
//
// Spec §5A pairs this exact objection with "any HELD certification marks
// (ISO 27001 and similar)... contact page only. For a sovereignty-sensitive
// buyer these outperform any visual treatment" — a natural third element —
// but it is deliberately omitted, not merely unsupplied (P9, user decision
// 2026-08-17): Intertec Systems holds company-level certifications, but the
// TruMandate product itself does not, and a certification mark on this page
// would read as a claim that the product holds one. Spec §5A's own word is
// "held" — showing the mark here would not be held, it would be borrowed.
// Two lines it is, and this is the reason the third stays empty rather than
// pending.
//
// No product imagery, no AI: this is plain page typography on a hairline
// rule, matching ObjectiveRecord.astro's "page typography, not product
// chrome" treatment rather than a card.
//
// The Intertec Systems mark (P9c): spec §5A's own asset line reads "Intertec
// Systems logo, SVG, footer and contact page" — a second, deliberate
// placement distinct from Footer.astro's (P9b), not merely the site-wide
// footer showing up here too. It sits in this band rather than anywhere else
// on the page because this is the one place `/contact` already carries a
// vendor-trust argument for the same sovereignty-sensitive reader spec §5A
// names for the (deliberately omitted, see above) certification marks — the
// mark is the honest half of that pairing: Intertec Systems is the operator
// of record, unlike a certification the product itself does not hold.
// Reuses `IntertecLogo.astro` exactly as Footer.astro does — same
// `currentColor` mark, same `footer.company` aria-label (no new i18n string
// needed) — sized and coloured to this band's own `text-muted` eyebrow
// rather than repeated at footer scale, so it reads as a small credential
// beside the claim, not a second footer. No visible "Intertec Systems" text
// is repeated here: the footer immediately below already spells out the
// full "Intertec Systems · Dubai" credit, and role="img" + aria-label carry
// the accessible name without echoing it visually a second time on the same
// page. Flex-row order auto-mirrors under `dir="rtl"` exactly as Footer's
// does, so the Latin wordmark stays unmirrored in both languages.
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/types";
import IntertecLogo from "../layout/IntertecLogo.astro";

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
---

{
  /* P10 (DESIGN-ELEVATION.md §4.5): the top rule becomes a `highlight` edge
     rather than `hairline` — "so the band reads as a raised credential
     rather than a stray paragraph." Decoration only, never text, so the
     lower-contrast token carries no AA obligation. */
}
<div class="max-w-measure border-t border-highlight pt-8">
  <p class="font-mono text-eyebrow font-data uppercase tracking-eyebrow text-muted">
    {t("contact.sovereigntyEyebrow")}
  </p>
  <p class="mt-3 text-body font-light text-body">
    {t("contact.sovereigntyBody")}
  </p>
  <p class="mt-6 inline-flex items-center text-muted">
    <IntertecLogo label={t("footer.company")} class="h-[1.4em] w-auto shrink-0" />
  </p>
</div>
