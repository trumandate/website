---
// ClosingCta.astro — redesign wave A (Home (redesign).dc.html §7). Grid
// ground + `bg-ground-board`, the closing heading, a CTA pair, and a right
// column of three hairline rows (Deployment / Language / Operated by). No
// Command Centre composition here any more — CommandCentreDim.astro (the
// pre-redesign dimmed board) is deleted alongside the rest of the old home
// tree; the redesign's own board already lives in the hero.
import Section from "../layout/Section.astro";
import Button from "../ui/Button.astro";
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/types";

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);

const rows = [
  { label: t("home.closingCta.row1Label"), body: t("home.closingCta.row1Body") },
  { label: t("home.closingCta.row2Label"), body: t("home.closingCta.row2Body") },
  { label: t("home.closingCta.row3Label"), body: t("home.closingCta.row3Body") },
];
---

<Section bleed>
  <Fragment slot="backdrop">
    <div
      class="absolute inset-0 bg-grid-draft"
      style="mask-image: linear-gradient(to bottom, transparent 0%, black 18%, black 82%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 18%, black 82%, transparent 100%);"
    >
    </div>
    <div class="absolute inset-0 bg-ground-board"></div>
  </Fragment>

  <div class="relative z-10 mx-auto max-w-content px-gutter">
    <div
      class="tm-rise items-start"
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: clamp(24px, 4vw, 64px);"
    >
      <div>
        <p class="font-mono text-eyebrow font-data uppercase tracking-eyebrow text-mint">
          {t("home.closingCta.eyebrow")}
        </p>
        <h2
          class="mt-4 max-w-[24ch] font-sans text-h2 font-semi tracking-heading text-paper"
          style="text-wrap: pretty;"
        >
          {t("home.closingCta.heading")}
        </h2>
        <p
          class="mt-6 max-w-[50ch] text-lede font-light text-body"
        >
          {t("home.closingCta.body")}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <Button
            href={`/${lang}/contact`}
            style="min-height: 46px; padding-inline: 24px;"
          >
            {t("cta.primary")}
          </Button>
          <Button
            variant="ghost"
            href="mailto:trumandate@intertecsys.com"
            style="min-height: 46px; padding-inline: 24px;"
          >
            {t("home.closingCta.secondaryLabel")}
          </Button>
        </div>
      </div>

      <div style="display: grid; gap: 0;">
        {
          rows.map((row, i) => (
            <div
              class:list={[
                "border-t border-hairline",
                i === rows.length - 1 && "border-b",
              ]}
              style="padding: 14px 0;"
            >
              <p class="font-mono text-eyebrow font-data uppercase tracking-eyebrow text-muted">
                {row.label}
              </p>
              <p class="mt-2 text-body font-light text-body">{row.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Section>
