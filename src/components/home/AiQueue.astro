---
// AiQueue.astro — redesign wave A (Home (redesign).dc.html §4). Three
// hue-coded suggestion cards (execution mint, strategy cyan, benefits gold)
// with a gradient confidence bar (scaleX draw via `.tm-grow`), Accept/
// Modify/Reject, and a mono audit line each; a single mint audit line below
// the cards (user review fix, post-redesign — see that line's own comment
// further down). Distinct from `SuggestionCard.astro` (components/ai/),
// which stays untouched and still backs the product pages' own single AI
// moment.
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/types";

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
const isAr = lang === "ar";

const cards = [
  {
    hue: "mint" as const,
    delay: undefined,
    spotlight: true,
    badge: t("home.aiQueue.card1Badge"),
    confidence: "0.74",
    width: "74%",
    title: t("home.aiQueue.card1Title"),
    detail: t("home.aiQueue.card1Detail"),
    log: t("home.aiQueue.card1Log"),
  },
  {
    hue: "cyan" as const,
    delay: "130ms",
    spotlight: false,
    badge: t("home.aiQueue.card2Badge"),
    confidence: "0.81",
    width: "81%",
    title: t("home.aiQueue.card2Title"),
    detail: t("home.aiQueue.card2Detail"),
    log: t("home.aiQueue.card2Log"),
  },
  {
    hue: "gold" as const,
    delay: "260ms",
    spotlight: false,
    badge: t("home.aiQueue.card3Badge"),
    confidence: "0.69",
    width: "69%",
    title: t("home.aiQueue.card3Title"),
    detail: t("home.aiQueue.card3Detail"),
    log: t("home.aiQueue.card3Log"),
  },
];

const hueText: Record<string, string> = {
  mint: "text-mint",
  cyan: "text-cyan",
  gold: "text-gold",
};
const hueBorderStart: Record<string, string> = {
  mint: "border-s-2 border-s-accent",
  cyan: "border-s-2 border-s-cyan",
  gold: "border-s-2 border-s-gold",
};
const hueBg: Record<string, string> = {
  mint: "bg-jade",
  cyan: "bg-surface",
  gold: "bg-surface",
};
const hueShadow: Record<string, string> = {
  mint: "shadow-focal",
  cyan: "shadow-card-cyan",
  gold: "shadow-card-gold",
};
const hueGrad: Record<string, string> = {
  mint: isAr ? "bg-grad-mint-rtl" : "bg-grad-mint",
  cyan: isAr ? "bg-grad-cyan-rtl" : "bg-grad-cyan",
  gold: isAr ? "bg-grad-gold-rtl" : "bg-grad-gold",
};

// Audit strip (user review fix, post-redesign, revised per the user's own
// mockup): the four-item strip read as disconnected floating fragments no
// matter how the columns were tightened, so it is cut to the one line that
// actually carries weight — a single mint mono sentence under a hairline
// rule, inline-start aligned, with generous room above and below rather than
// packed against the cards.
---

<section class="relative w-full py-section">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0">
    <div class="absolute inset-0 bg-surface-deep"></div>
    <div class="absolute inset-x-0 top-0 h-32 bg-seam-down"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-content px-gutter">
    <div
      class="items-end gap-6"
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: clamp(20px, 3vw, 48px);"
    >
      <div class="tm-rise">
        <p class="font-mono text-eyebrow font-data uppercase tracking-eyebrow text-muted">
          {t("home.aiQueue.eyebrow")}
        </p>
        <h2
          class="mt-4 max-w-[26ch] font-sans text-h2 font-semi tracking-heading text-paper"
          style="text-wrap: pretty;"
        >
          {t("home.aiQueue.heading")}
        </h2>
      </div>
      <p
        class="tm-rise max-w-measure-tight text-lede font-light text-body"
        style="--d: 120ms;"
      >
        {t("home.aiQueue.body")}
      </p>
    </div>

    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 288px), 1fr)); gap: 16px; margin-top: clamp(32px, 4vw, 56px);"
    >
      {
        cards.map((card) => (
          <div
            class:list={[
              "tm-rise relative rounded-control border-y border-e p-[22px] border-hairline",
              hueBorderStart[card.hue],
              hueBg[card.hue],
              hueShadow[card.hue],
            ]}
            style={card.delay ? `--d: ${card.delay};` : undefined}
          >
            {card.spotlight && (
              <div
                aria-hidden="true"
                class="pointer-events-none absolute -inset-10 z-0 bg-spotlight-accent"
              />
            )}
            <div class="relative z-10">
              <div class="flex items-baseline justify-between gap-3">
                <span
                  class:list={[
                    "font-mono text-eyebrow font-data uppercase tracking-eyebrow",
                    hueText[card.hue],
                  ]}
                >
                  {card.badge}
                </span>
                <span
                  dir="ltr"
                  class:list={[
                    "font-mono text-eyebrow font-data uppercase tracking-eyebrow",
                    hueText[card.hue],
                  ]}
                >
                  {card.confidence}
                </span>
              </div>
              <div class="relative mt-3.5 h-0.5 w-full bg-hairline">
                <div
                  class:list={["tm-grow absolute inset-y-0 h-0.5", hueGrad[card.hue]]}
                  style={`inset-inline-start: 0; width: ${card.width};`}
                />
              </div>
              <h3 class="mt-5 font-sans text-h3 font-semi tracking-heading text-paper">
                {card.title}
              </h3>
              <p class="mt-3 text-body font-light text-body">{card.detail}</p>
              <div class="mt-6 flex flex-wrap gap-3">
                <button
                  type="button"
                  class="rounded-control border border-accent px-4 py-2.5 text-small font-semi text-accent transition-colors duration-micro ease-micro hover:bg-accent hover:text-ink"
                >
                  {t("home.ai.accept")}
                </button>
                <button
                  type="button"
                  class="rounded-control border border-hairline px-4 py-2.5 text-small font-semi text-paper transition-colors duration-micro ease-micro hover:border-muted"
                >
                  {t("home.ai.modify")}
                </button>
                <button
                  type="button"
                  class="rounded-control border border-hairline px-4 py-2.5 text-small font-semi text-paper transition-colors duration-micro ease-micro hover:border-muted"
                >
                  {t("home.ai.reject")}
                </button>
              </div>
              <p class="mt-6 font-mono text-datum font-data tracking-datum text-muted">
                {card.log}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <p
      class="tm-fade m-0 border-t border-hairline font-mono text-datum font-data tracking-datum text-mint"
      style="--d: 200ms; margin-top: clamp(32px, 4vw, 48px); padding-top: clamp(20px, 2.5vw, 28px);"
    >
      {t("home.aiQueue.auditLine")}
    </p>
  </div>
</section>
