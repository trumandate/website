---
// Hero.astro — redesign wave A (Home (redesign).dc.html §1-2 / Home AR
// (redesign).dc.html). Centered hero: eyebrow → H1 with a mint→cyan
// gradient-clip key phrase → lede → two CTAs → the Command Centre board,
// cropped and masked (the deliberate withholding mechanism, never the full
// board — README §2).
//
// Motion is the reference's own `.tm-load`/`.tm-boardload` load cascade
// (global.css), not scripts/hero.ts's GSAP SplitText timeline — that script
// (and Spine/ObjectiveRecord, this file's own former imports) belonged to
// the pre-redesign hero and is deleted alongside it. `--d` inline custom
// properties set each element's stagger delay, exactly per the reference.
//
// The board sits in its own `max-width: 1280px` column, wider than the
// site's usual `max-w-content` (1180px) — reproduced with `Section bleed`
// (drops Section's own inner wrapper) plus two hand-authored wrapper divs,
// matching the reference's own two-wrapper structure exactly.
import Section from "../layout/Section.astro";
import CommandCentreBoard from "../board/CommandCentreBoard.astro";
import Button from "../ui/Button.astro";
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/types";

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
const isAr = lang === "ar";
---

<Section bleed texture pad={false}>
  <Fragment slot="backdrop">
    <div class="absolute inset-0 bg-ground-rise"></div>
  </Fragment>

  <div
    class="relative z-10 mx-auto max-w-content px-gutter text-center"
    style="padding-top: clamp(3.5rem, 8vh, 6rem);"
  >
    <p class="tm-load font-mono text-eyebrow font-data uppercase tracking-eyebrow text-muted">
      {t("home.hero.eyebrow")}
    </p>
    <h1
      class="tm-load mt-5 font-sans text-display font-semi tracking-display text-paper lg:tracking-display-lg"
      style={`--d: 90ms; max-width: 17ch; margin-inline: auto; text-wrap: balance;`}
    >
      {t("home.hero.headlineLead")}<span
        class:list={["gradient-text", isAr ? "bg-gradient-text-rtl" : "bg-gradient-text"]}
        >{t("home.hero.headlineGradient")}</span
      >{t("home.hero.headlineTail")}
    </h1>
    <p
      class="tm-load mt-6 text-lede font-light text-body"
      style="--d: 180ms; max-width: 54ch; margin-inline: auto;"
    >
      {t("home.hero.lede")}
    </p>
    <div
      class="tm-load mt-8 flex flex-wrap items-center justify-center gap-4"
      style="--d: 270ms;"
    >
      <Button
        href={`/${lang}/contact`}
        style="min-height: 46px; padding-inline: 24px;"
      >
        {t("cta.primary")}
      </Button>
      <Button
        variant="ghost"
        href="#record"
        style="min-height: 46px; padding-inline: 24px;"
      >
        {t("cta.secondary")}
      </Button>
    </div>
  </div>

  <div
    class="relative z-10 mx-auto px-gutter"
    style="max-width: 1280px; margin-top: clamp(36px, 5vh, 64px);"
  >
    <div class="tm-boardload relative" style="--d: 420ms;">
      <div
        data-board-fit
        class="relative z-[1] overflow-hidden"
        style="max-height: clamp(340px, 44vw, 580px); mask-image: linear-gradient(to bottom, black 0%, black 52%, rgba(0,0,0,0.35) 82%, transparent 99%); -webkit-mask-image: linear-gradient(to bottom, black 0%, black 52%, rgba(0,0,0,0.35) 82%, transparent 99%);"
      >
        <CommandCentreBoard lang={lang} />
      </div>
    </div>
    <p
      class="tm-load mt-0.5 text-center font-mono text-datum font-data tracking-datum text-muted"
      style="--d: 700ms;"
    >
      {t("home.hero.boardCaption")}
    </p>
  </div>
</Section>

<script src="../../scripts/board.ts"></script>
