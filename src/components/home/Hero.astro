---
// Hero.astro — type only, no card, no panel border (PLAN.md §3). Copy
// verbatim from content brief §1. The eyebrow sits on the spine's first
// node, unlit and hairline-outlined rather than accent — PLAN.md: "the
// signature is the only place boldness is spent," and that's the chain,
// not the hero. The hero data panel (content brief's objective record)
// attaches as the spine's second node, at full text-column width rather
// than a side gutter (the binding decision that keeps the home page's
// product-surface count at two, not three).
//
// Node dots are positioned with `start-[-0.5rem]`, not `start-node-inset`,
// because each node's wrapper is a direct child of the `ps-rail` div below —
// whose own edge already sits at the `rail` token (54px) from the section's
// true start edge. `rail (54px) - node-inset (46px) = 8px (0.5rem)`, so
// walking back half a rem from a ps-rail child's own edge lands the node's
// left edge exactly on the rail's line; `-translate-x-1/2` then centres the
// 13px node on that point. Anchoring each node to its own row (rather than
// computing a cumulative offset from the top of the hero) keeps this correct
// under the fluid `clamp()` type scale, where the height above any given row
// changes with viewport width.
//
// P10 (DESIGN-ELEVATION.md §3.3): `data-hero` scopes scripts/hero.ts's own
// load-sequence timeline (eyebrow → SplitText headline lines → lede → CTA
// row, then the objective-record rows on their own scroll trigger) — a
// dedicated script rather than an addition to reveal.ts, since it's the one
// place on the site SplitText runs. The lede is now two-tone (`ledeLead` in
// `paper`, `ledeRest` in `body`, i18n/ui.ts) and the CTA row carries
// `hero-cta-row` purely as hero.ts's query hook, not for styling.
//
// Each Button also carries `class="reveal"` — CLAUDE.md's "end state lives
// in CSS, GSAP animates from an offset" contract, made explicit rather than
// incidental: these anchors already have no opacity/transform of their own,
// so `.reveal` (global.css: opacity 1, translateY 0) changes nothing
// visually, but it states in markup — the same way ObjectiveRecord's rows
// and FailureModes' group children do — that this is the served,
// unconditional end state a JS failure or a hung tween must fall back to.
// See hero.ts's own comment for the defect this addressed (a CSS
// `transition` on these same buttons fighting GSAP's per-frame writes on a
// staggered/delayed target) and its fix (neutralising the transition for
// the tween's duration, restored after via `clearProps`).
import Spine from "./Spine.astro";
import ObjectiveRecord from "./ObjectiveRecord.astro";
import Eyebrow from "../type/Eyebrow.astro";
import Display from "../type/Display.astro";
import Lede from "../type/Lede.astro";
import Button from "../ui/Button.astro";
import Reveal from "../ui/Reveal.astro";
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/types";

interface Props {
  lang: Language;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
---

<div class="relative" data-hero>
  <Spine variant="hairline" />

  <Reveal as="div" class="ps-rail">
    <div class="relative">
      <span
        aria-hidden="true"
        class="absolute start-[-0.5rem] top-1 size-node -translate-x-1/2 rounded-full ring-1 ring-hairline"
      ></span>
      <Eyebrow>{t("home.hero.eyebrow")}</Eyebrow>
    </div>

    <Display class="mt-4 max-w-measure-head">
      {t("home.hero.headline")}
    </Display>

    <Lede class="mt-6"
      ><span class="text-paper">{t("home.hero.ledeLead")}</span>{" "}<span
        class="text-body">{t("home.hero.ledeRest")}</span
      ></Lede
    >

    <div class="hero-cta-row mt-8 flex flex-wrap items-center gap-4">
      <Button class="reveal" href={`/${lang}/contact`}>{t("cta.primary")}</Button>
      <Button class="reveal" variant="ghost" href="#chain">{t("cta.secondary")}</Button>
    </div>

    <div class="relative mt-16">
      <span
        aria-hidden="true"
        class="absolute start-[-0.5rem] top-1 size-node -translate-x-1/2 rounded-full ring-1 ring-hairline"
      ></span>
      <ObjectiveRecord lang={lang} />
    </div>
  </Reveal>
</div>

<script src="../../scripts/hero.ts"></script>
