---
// Spine.astro — the rail, shared hero → chain → AI (PLAN.md §3, "the one
// idea"). Renders only the vertical line; the caller supplies its own
// `position: relative` ancestor and applies `ps-rail` to whichever content
// needs to clear it, so every section's line sits in one shared coordinate
// space (spec §8: `inset-inline-start`, mirrors under RTL for free).
//
// `variant="dashed"` is the problem section's broken segment: no nodes,
// because that section is about the chain not existing (PLAN.md's own
// self-critique: "the one accessory to remove if anything has to go").
// `variant="filled"` is the chain's fully-resolved end state — solid accent,
// untransformed (== `scaleY(1)`), which is exactly what a reduced-motion
// reader or a JS failure sees. `scripts/chain.ts` (motion #1) selects this
// element via `[data-chain-rail]` and runs `gsap.fromTo(rail, {scaleY: 0},
// {scaleY: 1, scrollTrigger: {scrub: true, ...}})`: it never edits the served
// markup's state, only tweens away from it and back. `origin-top` is a
// physical value, not a logical one, on purpose — this is a block-axis
// (vertical) transform and spec §8 is explicit that vertical motion does not
// mirror under RTL, so "top" is direction-independent here.
//
// P10 (DESIGN-ELEVATION.md §3.5(a)): the filled rail's flat `bg-accent`
// becomes a vertical gradient — `accent` at 35% for the first 82%, ramping
// to full `accent` at 100%. Because this element is scaled with `scaleY`
// from `origin-top`, its PAINTED content scales with it, so the bright stop
// is always at the rail's currently-drawn end: the drawn portion reads as
// recorded and settled, the head reads as live. Zero new JS, zero new
// animation — a background-image is paint, not motion (CLAUDE.md). Written
// as a scoped rule rather than a new `tailwind.config.mjs` background-image
// token: DESIGN-ELEVATION.md's own §2.6 count (7 layers) doesn't include
// this one, and `theme()` inside a component `<style>` block (the same
// technique Header.astro already uses for its hairline colour) keeps the
// rgba literal commented against the token it derives from, exactly as the
// config file's own convention requires, without adding an eighth entry to
// a list the spec states as exactly seven.
interface Props {
  variant?: "hairline" | "dashed" | "filled";
  class?: string;
}

const { variant = "hairline", class: className }: Props = Astro.props;

const styles: Record<NonNullable<Props["variant"]>, string> = {
  hairline: "w-px bg-hairline",
  filled: "w-px origin-top",
  dashed: "border-s border-dashed border-hairline",
};
---

<div
  aria-hidden="true"
  data-chain-rail={variant === "filled" ? true : undefined}
  class:list={[
    "pointer-events-none absolute start-node-inset top-0 bottom-0",
    styles[variant],
    className,
  ]}
></div>

<style>
  /* rgba(25,195,155,…) is `accent` — tailwind.config.mjs — at 35%/100%. */
  [data-chain-rail] {
    background-image: linear-gradient(
      to bottom,
      rgba(25, 195, 155, 0.35) 0%,
      rgba(25, 195, 155, 0.35) 82%,
      theme("colors.accent") 100%
    );
  }
</style>
