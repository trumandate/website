---
// BaseLayout.astro — html lang/dir, head, per-locale font preload, skip
// link, header, footer, slot. Every page composes this; no page sets its
// own <html> attributes or font links.
import "../styles/global.css";
import { directionFor, type Language } from "../i18n/types";
import { useTranslations } from "../i18n/utils";
import SkipLink from "../components/layout/SkipLink.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Meta from "../components/seo/Meta.astro";
import JsonLd from "../components/seo/JsonLd.astro";
// CLAUDE.md: "no hex value outside tailwind.config.mjs." <meta name="theme-color">
// needs a literal colour string (there is no Tailwind-class equivalent for a
// browser-chrome tint), so the value is imported from the config at build
// time rather than re-typed as a second hex literal in this file.
import tailwindConfig from "../../tailwind.config.mjs";

interface Props {
  lang: Language;
  title: string;
  description: string;
  /** Route suffix after the /{lang}/ prefix: "/" for the home page,
   * "/strategy" | "/execution" | "/benefits" | "/contact" otherwise — the
   * same shape i18n/utils.ts's `pairedRoutes` already uses. Drives the
   * canonical URL, hreflang alternates and og:url in Meta.astro (P9). */
  path: string;
  /** Blog section only (BUILD_FLAGS.md's 2026-08-19 entry): the per-language
   * RSS feed href, rendered as a `<link rel="alternate" type="application/
   * rss+xml">` for feed-reader autodiscovery. Optional and undefined on
   * every other route — this file is the only place `<head>` is assembled
   * ("no page sets its own <html> attributes or font links"), so a blog page
   * cannot add this tag on its own without either this small optional prop
   * or a second head-assembling layout; the optional prop keeps every
   * non-blog route byte-for-byte unchanged. */
  rssHref?: string;
}

const { lang, title, description, path, rssHref } = Astro.props;
const dir = directionFor[lang];
const t = useTranslations(lang);
// Tailwind's own `Config` type allows `theme.colors` to be either a plain
// object or a function of PluginUtils (for themes that compute colours),
// so TypeScript can't narrow it from the JSDoc-typed import alone. This
// project's config (tailwind.config.mjs) always writes a plain object —
// asserting that actual, known shape here is narrower and more honest than
// reaching for `any`.
const themeColor = (
  tailwindConfig as { theme: { colors: Record<string, string> } }
).theme.colors.jade;

// PLAN.md §1: no locale loads all five font files.
// /en preloads sans-latin-300/600 + mono-latin-500.
// /ar preloads sans-arabic-300/600 + sans-latin-300/600 (TruMandate stays
// Latin script, KPI values stay Western digits) and never preloads Plex Mono
// — spec §3 swaps that role to Plex Sans 600 in Arabic.
const fontPreloads =
  lang === "ar"
    ? [
        "/fonts/plex-sans-arabic-arabic-300.woff2",
        "/fonts/plex-sans-arabic-arabic-600.woff2",
        "/fonts/plex-sans-arabic-latin-300.woff2",
        "/fonts/plex-sans-arabic-latin-600.woff2",
      ]
    : [
        "/fonts/plex-sans-arabic-latin-300.woff2",
        "/fonts/plex-sans-arabic-latin-600.woff2",
        "/fonts/plex-mono-latin-500.woff2",
      ];
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Meta
      lang={lang}
      path={path}
      title={title}
      description={description}
      ogImageAlt={t("meta.ogImageAlt")}
    />
    <JsonLd lang={lang} path={path} title={title} description={description} />
    {
      rssHref && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={`${t("brand.name")} — ${t("nav.blog")}`}
          href={rssHref}
        />
      )
    }

    <!-- Favicon set (P9, spec §5A; PNG sizes + optically-corrected geometry
         added later — see public/favicon.svg's own comment for why its
         geometry no longer matches Header.astro's lockup): the SVG mark is
         the primary icon in browsers that support it. The explicit PNG links
         below exist for Google Search (which reads sized <link rel="icon">
         PNGs from the homepage head and prefers a size that's a multiple of
         48px) and for browsers/surfaces that don't take SVG favicons.
         favicon.ico (16/32/48, one file, still at the root) is the fallback
         both Google and older browsers reach for automatically even without
         a <link> tag. apple-touch-icon covers iOS/iPadOS home-screen
         bookmarks specifically — Apple never reads favicon.svg or the
         manifest for that icon. theme-color tints mobile browser chrome
         (Android Chrome address bar, iOS Safari status bar) with the same
         `jade` raised-surface token the manifest uses, not a new value. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link
      rel="icon"
      href="/favicon-192.png"
      type="image/png"
      sizes="192x192"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={themeColor} />
    {
      fontPreloads.map((href) => (
        <link
          rel="preload"
          href={href}
          as="font"
          type="font/woff2"
          crossorigin
        />
      ))
    }
    <!-- Redesign wave A: `.tm-load`/`.tm-boardload`/`.tm-rise`/`.tm-fade`/
         `.tm-grow` (global.css) ship hidden by default — the CSS transition/
         animation itself is what reveals them, driven by `.tm-in` (added by
         scripts/redesignReveal.ts's IntersectionObserver) or by the real
         `prefers-reduced-motion: reduce` media query. Neither fires when
         JavaScript is disabled outright and the visitor has no reduced-
         motion preference, which would leave every one of those elements at
         its hidden starting opacity forever — CLAUDE.md's "the site must be
         readable with JavaScript disabled" failing silently. This is the
         fix: the same end-state declarations the reduced-motion media query
         already applies, scoped to `<noscript>` so they only ever engage
         when script did not run at all. -->
    <noscript>
      <style>
        .tm-load,
        .tm-boardload,
        .tm-rise,
        .tm-fade,
        .tm-grow {
          opacity: 1;
          transform: none;
          animation: none;
          transition: none;
        }
        .tm-live,
        .tm-live-r {
          animation: none;
        }
        .tm-spark {
          animation: none;
          stroke-dashoffset: 0;
        }
      </style>
    </noscript>
  </head>
  <body>
    <SkipLink lang={lang} />
    <Header lang={lang} />
    <!-- pt-header clears the fixed header's rendered height (`header` token,
         tailwind.config.mjs — 73px, re-measured for the redesign wave A home
         fidelity fix: the header now renders at 71.3125px, both languages,
         375 and 1440 widths). See that token's own comment for the P2 value
         (94.625px) this replaces and why it shrank. -->
    <main id="main" class="pt-header">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
