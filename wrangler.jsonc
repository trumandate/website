{
	// Cloudflare Workers static-assets config — fully static site, no Worker code.
	// Dashboard Git import reads this; build command: npm run build, deploy: npx wrangler deploy
	"name": "trumandate-website",
	"compatibility_date": "2026-08-17",
	// Build the site before uploading. Declared here so a deploy works even when
	// the CI build command is unset — wrangler runs this itself, then uploads
	// ./dist. Without it a bare `wrangler versions upload` fails: no dist/.
	"build": {
		"command": "npm run build"
	},
	"assets": {
		"directory": "./dist"
	},
	// Workers Logs. Full sampling is right at this traffic level; lower
	// head_sampling_rate if request volume ever makes the log volume costly.
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": true,
			"head_sampling_rate": 1
		}
	}
}
